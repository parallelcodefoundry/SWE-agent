#!/bin/bash

# Nsight Compute Profiling Tool for SWE-agent
# Profiles CUDA kernels with ncu and extracts key GPU metrics

main() {
    if [ $# -lt 2 ]; then
        echo "Usage: ncu_profile <executable> <output_dir> [<kernel_filter>] [<app_args>...]"
        echo ""
        echo "Arguments:"
        echo "  executable    - Path to the CUDA executable to profile"
        echo "  output_dir    - Directory to store profiling results"
        echo "  kernel_filter - Optional: kernel name substring for detailed profiling"
        echo "  app_args      - Optional: arguments to pass to the application"
        echo ""
        echo "Examples:"
        echo "  ncu_profile ./lulesh ./ncu_out"
        echo "  ncu_profile ./lulesh ./ncu_out CalcVolumeForce \"-s 30\""
        return 1
    fi

    local executable="$1"
    local output_dir="$2"
    shift 2

    # Check if next arg looks like a kernel filter (no leading dash, not empty)
    local kernel_filter=""
    if [ $# -gt 0 ] && [[ -n "$1" ]] && [[ "$1" != -* ]]; then
        kernel_filter="$1"
        shift
    fi

    # Collect remaining args, word-splitting quoted strings like "-s 30" into -s 30
    local app_args=()
    for arg in "$@"; do
        # shellcheck disable=SC2206
        app_args+=($arg)
    done

    # Validate executable
    if [ ! -f "$executable" ] && ! command -v "$executable" &> /dev/null; then
        echo "Error: Executable '$executable' not found"
        return 1
    fi

    # Find ncu binary
    local NCU=""
    if command -v ncu &> /dev/null; then
        NCU="ncu"
    else
        # Try known Perlmutter paths
        local ncu_paths=(
            "/opt/nvidia/hpc_sdk/Linux_x86_64/25.5/profilers/Nsight_Compute/ncu"
            "/opt/nvidia/hpc_sdk/Linux_x86_64/24.5/profilers/Nsight_Compute/ncu"
            "/opt/nvidia/hpc_sdk/Linux_x86_64/25.3/profilers/Nsight_Compute/ncu"
            "/opt/nvidia/hpc_sdk/Linux_x86_64/24.7/profilers/Nsight_Compute/ncu"
        )
        for ncu_path in "${ncu_paths[@]}"; do
            if [ -f "$ncu_path" ]; then
                NCU="$ncu_path"
                break
            fi
        done
    fi

    if [ -z "$NCU" ]; then
        echo "Error: Nsight Compute (ncu) not found"
        echo "Try loading the CUDA toolkit or setting PATH to include the ncu binary"
        return 1
    fi

    # Create output directory
    mkdir -p "$output_dir"
    output_dir=$(realpath "$output_dir")

    local report_file="$output_dir/report.ncu-rep"
    local csv_file="$output_dir/metrics_summary.csv"
    local summary_file="$output_dir/summary.txt"

    echo "=== Nsight Compute Kernel Profiling ==="
    echo "Executable: $executable"
    echo "Output directory: $output_dir"
    echo "NCU binary: $NCU"
    if [ -n "$kernel_filter" ]; then
        echo "Kernel filter: $kernel_filter (detailed mode, regex match)"
    else
        echo "Mode: basic (all kernels)"
    fi
    if [ ${#app_args[@]} -gt 0 ]; then
        echo "Application arguments: ${app_args[*]}"
    fi
    echo ""

    # Pause DCGM if available (required for profiling on managed clusters)
    if command -v dcgmi &> /dev/null; then
        echo "Pausing DCGM..."
        dcgmi profile --pause 2>/dev/null || true
    fi

    # Build ncu command
    local ncu_cmd=("$NCU" "--clock-control" "base" "--target-processes" "all" "-o" "$report_file" "-f")

    if [ -n "$kernel_filter" ]; then
        # Detailed mode: profile specific kernel(s) with full metrics
        # Use regex: prefix so kernel_filter is a substring match
        ncu_cmd+=("--set" "detailed" "--kernel-name" "regex:$kernel_filter" "-c" "3")
    else
        # Basic mode: skip 1 warmup launch, collect 50 samples to cover multiple kernel types
        ncu_cmd+=("--set" "basic" "-s" "1" "-c" "50")
    fi

    ncu_cmd+=("$executable")
    if [ ${#app_args[@]} -gt 0 ]; then
        ncu_cmd+=("${app_args[@]}")
    fi

    echo "Command: ${ncu_cmd[*]}"
    echo ""

    # Run profiling
    local start_time
    start_time=$(date +%s)
    if ! "${ncu_cmd[@]}"; then
        echo "Error: ncu profiling failed"
        if command -v dcgmi &> /dev/null; then
            dcgmi profile --resume 2>/dev/null || true
        fi
        return 1
    fi
    local end_time
    end_time=$(date +%s)
    local elapsed=$((end_time - start_time))
    echo ""
    echo "Profiling wall time: ${elapsed}s"

    # Resume DCGM
    if command -v dcgmi &> /dev/null; then
        echo "Resuming DCGM..."
        dcgmi profile --resume 2>/dev/null || true
    fi

    # Extract CSV metrics from the report
    # Use metric names confirmed available in both basic and detailed ncu sets:
    #   gpu__time_duration.sum              - kernel execution time
    #   sm__throughput.avg.pct_of_peak_sustained_elapsed  - compute (SM) utilization
    #   dram__cycles_active.avg.pct_of_peak_sustained_elapsed - DRAM utilization
    #   l1tex__throughput.avg.pct_of_peak_sustained_active    - L1 cache utilization (detailed only)
    #   sm__warps_active.avg.pct_of_peak_sustained_active     - warp occupancy
    #   launch__registers_per_thread        - registers per thread
    #   launch__shared_mem_per_block_allocated - shared memory per block
    #   launch__grid_size                   - grid dimensions
    #   launch__block_size                  - block dimensions
    local METRICS="gpu__time_duration.sum"
    METRICS+=",sm__throughput.avg.pct_of_peak_sustained_elapsed"
    METRICS+=",dram__cycles_active.avg.pct_of_peak_sustained_elapsed"
    METRICS+=",l1tex__throughput.avg.pct_of_peak_sustained_active"
    METRICS+=",sm__warps_active.avg.pct_of_peak_sustained_active"
    METRICS+=",launch__registers_per_thread"
    METRICS+=",launch__shared_mem_per_block_allocated"
    METRICS+=",launch__grid_size"
    METRICS+=",launch__block_size"

    echo ""
    echo "=== Extracting Metrics ==="
    if "$NCU" --import "$report_file" --csv --page raw --metrics "$METRICS" > "$csv_file" 2>/dev/null; then
        echo "CSV saved to: $csv_file"
    else
        echo "Warning: CSV extraction failed (report may still be valid)"
    fi
    echo ""

    # Parse and display summary
    echo "=== Top Kernels by Execution Time ==="
    python3 - "$csv_file" "$summary_file" << 'PYEOF'
import csv, sys

csv_file = sys.argv[1]
summary_file = sys.argv[2]

try:
    kernels = {}

    def parse_num(val, default=0):
        """Parse a number that may contain commas (thousands separator) or units."""
        if val is None:
            return default
        val = str(val).strip().strip('"')
        if not val:
            return default
        # Remove commas used as thousands separators
        val = val.replace(',', '')
        try:
            return float(val)
        except ValueError:
            return default

    # Detect units row (row after header where values are unit names like 'us', '%', etc.)
    time_unit_factor = 1.0  # default: assume microseconds -> keep as us
    with open(csv_file, 'r') as f:
        reader = csv.reader(f)
        header = next(reader)
        # Check for units row
        units_row = next(reader, None)
        if units_row:
            # Find the time column index
            time_col_idx = None
            for i, h in enumerate(header):
                if 'gpu__time_duration' in h:
                    time_col_idx = i
                    break
            if time_col_idx is not None and time_col_idx < len(units_row):
                unit = units_row[time_col_idx].strip().strip('"')
                if unit == 'ns' or unit == 'nsecond':
                    time_unit_factor = 0.001  # ns -> us
                elif unit == 'us' or unit == 'usecond':
                    time_unit_factor = 1.0    # us -> us (keep)
                elif unit == 'ms' or unit == 'msecond':
                    time_unit_factor = 1000.0  # ms -> us

    with open(csv_file, 'r') as f:
        reader = csv.DictReader(f)
        row_count = 0
        for row in reader:
            row_count += 1
            # Skip units row (detected by non-numeric values in numeric columns)
            time_raw = row.get('gpu__time_duration.sum', '')
            if time_raw and not any(c.isdigit() for c in str(time_raw)):
                continue

            name = row.get('Kernel Name', '').strip('"')
            if not name:
                continue
            time_us = parse_num(row.get('gpu__time_duration.sum')) * time_unit_factor
            sm_pct = parse_num(row.get('sm__throughput.avg.pct_of_peak_sustained_elapsed'))
            dram_pct = parse_num(row.get('dram__cycles_active.avg.pct_of_peak_sustained_elapsed'))
            l1_pct = parse_num(row.get('l1tex__throughput.avg.pct_of_peak_sustained_active'))
            occ_pct = parse_num(row.get('sm__warps_active.avg.pct_of_peak_sustained_active'))
            regs = int(parse_num(row.get('launch__registers_per_thread')))
            smem = int(parse_num(row.get('launch__shared_mem_per_block_allocated')))
            grid = int(parse_num(row.get('launch__grid_size')))
            block = int(parse_num(row.get('launch__block_size')))

            if name not in kernels:
                kernels[name] = {'time_us': 0, 'count': 0, 'sm': 0, 'dram': 0, 'l1': 0, 'occ': 0, 'regs': regs, 'smem': smem, 'grid': grid, 'block': block}
            k = kernels[name]
            k['time_us'] += time_us
            k['count'] += 1
            k['sm'] += sm_pct
            k['dram'] += dram_pct
            k['l1'] += l1_pct
            k['occ'] += occ_pct

    if not kernels:
        print(f'No kernel data found in CSV. (Processed {row_count} rows)')
        sys.exit(0)

    # Average the percentage metrics
    for k in kernels.values():
        n = k['count']
        if n > 0:
            k['sm'] /= n
            k['dram'] /= n
            k['l1'] /= n
            k['occ'] /= n

    # Sort by total time descending
    sorted_kernels = sorted(kernels.items(), key=lambda x: x[1]['time_us'], reverse=True)

    total_time_us = sum(v['time_us'] for v in kernels.values())
    total_invocations = sum(v['count'] for v in kernels.values())
    lines = []
    if total_time_us > 1000:
        lines.append(f'Total kernel time: {total_time_us/1000:.2f} ms ({len(kernels)} unique kernels, {total_invocations} invocations)')
    else:
        lines.append(f'Total kernel time: {total_time_us:.2f} us ({len(kernels)} unique kernels, {total_invocations} invocations)')
    lines.append('')
    lines.append(f'{"Kernel":<60} {"Time(us)":>10} {"  %":>6} {"SM%":>6} {"DRAM%":>6} {"Occ%":>6} {"Regs":>5} {"Smem":>7} {"Grid":>8} {"Block":>6}')
    lines.append('-' * 130)

    for name, v in sorted_kernels[:20]:
        short = name[:58] + '..' if len(name) > 60 else name
        pct = 100.0 * v['time_us'] / total_time_us if total_time_us > 0 else 0
        lines.append(f'{short:<60} {v["time_us"]:>10.1f} {pct:>5.1f}% {v["sm"]:>5.1f}% {v["dram"]:>5.1f}% {v["occ"]:>5.1f}% {v["regs"]:>5} {v["smem"]:>7} {v["grid"]:>8} {v["block"]:>6}')

    lines.append('')
    # Bottleneck guidance
    lines.append('BOTTLENECK ANALYSIS:')
    for name, v in sorted_kernels[:5]:
        short = name[:50] + '..' if len(name) > 50 else name
        if v['sm'] > 60 and v['dram'] < 40:
            lines.append(f'  {short}: COMPUTE-BOUND (SM {v["sm"]:.0f}%, DRAM {v["dram"]:.0f}%)')
            lines.append(f'    -> Reduce arithmetic, use fast math, consider algorithm changes')
        elif v['dram'] > 40 and v['sm'] < 40:
            lines.append(f'  {short}: MEMORY-BOUND (SM {v["sm"]:.0f}%, DRAM {v["dram"]:.0f}%)')
            lines.append(f'    -> Improve coalescing, use shared memory, reduce global accesses')
        elif v['sm'] < 30 and v['dram'] < 30:
            lines.append(f'  {short}: LATENCY-BOUND (SM {v["sm"]:.0f}%, DRAM {v["dram"]:.0f}%, Occ {v["occ"]:.0f}%)')
            lines.append(f'    -> Increase occupancy (regs={v["regs"]}), reduce divergence, overlap compute+memory')
        else:
            lines.append(f'  {short}: MIXED (SM {v["sm"]:.0f}%, DRAM {v["dram"]:.0f}%)')
            lines.append(f'    -> Profile with detailed mode for specific optimization guidance')

    output = '\n'.join(lines)
    print(output)
    with open(summary_file, 'w') as f:
        f.write(output + '\n')

except Exception as e:
    import traceback
    print(f'Error parsing CSV: {e}')
    traceback.print_exc()
    sys.exit(1)
PYEOF

    echo ""
    echo "=== Nsight Compute Profiling Complete ==="
    echo "Report: $report_file"
    echo "Metrics CSV: $csv_file"
    echo "Summary: $summary_file"
    echo ""
    echo "For detailed analysis in GUI: ncu-ui $report_file"
    echo ""
}

main "$@"
