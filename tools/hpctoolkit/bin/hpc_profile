#!/bin/bash

# HPCToolkit Profiling Tool for SWE-agent
# Runs complete profiling workflow: hpcrun -> hpcstruct -> hpcprof

main() {
    if [ $# -lt 2 ]; then
        echo "Usage: hpc_profile <executable> <output_dir> [<app_args>...]"
        echo ""
        echo "Arguments:"
        echo "  executable  - Path to the executable to profile"
        echo "  output_dir  - Directory to store profiling results"
        echo "  app_args    - Optional arguments to pass to the application"
        echo ""
        echo "Examples:"
        echo "  hpc_profile ./myapp ./results"
        echo "  hpc_profile ./champs+ ./results -dev num-avail=4"
        echo "  hpc_profile ./myapp ./results --input data.txt --verbose"
        echo ""
        echo "Note: GPU count is controlled by your application arguments,"
        echo "      not by hpcrun. Use CUDA_VISIBLE_DEVICES to limit GPUs."
        return 1
    fi

    local executable="$1"
    local output_dir="$2"
    shift 2
    local app_args=("$@")

    # Validate executable exists
    if [ ! -f "$executable" ] && ! command -v "$executable" &> /dev/null; then
        echo "Error: Executable '$executable' not found"
        return 1
    fi

    # Check if HPCToolkit is available
    if ! command -v hpcrun &> /dev/null; then
        echo "Error: HPCToolkit not found. Please load HPCToolkit:"
        echo "  source ~/spack/share/spack/setup-env.sh"
        echo "  spack load hpctoolkit"
        return 1
    fi

    # Create output directory
    mkdir -p "$output_dir"
    output_dir=$(realpath "$output_dir")

    # Define paths
    local measurements_dir="$output_dir/measurements"
    local database_dir="$output_dir/database"

    echo "=== HPCToolkit Profiling Workflow ==="
    echo "Executable: $executable"
    echo "Output directory: $output_dir"
    if [ ${#app_args[@]} -gt 0 ]; then
        echo "Application arguments: ${app_args[*]}"
    fi
    echo ""

    # Pause DCGM if available
    if command -v dcgmi &> /dev/null; then
        echo "Pausing DCGM..."
        dcgmi profile --pause 2>/dev/null || true
    fi

    # Step 1: Run hpcrun
    echo "=== Step 1/3: Running hpcrun (profiling) ==="
    if [ ${#app_args[@]} -gt 0 ]; then
        echo "Command: hpcrun -e gpu=nvidia -tt -o $measurements_dir $executable ${app_args[*]}"
        if ! hpcrun -e gpu=nvidia -tt -o "$measurements_dir" "$executable" "${app_args[@]}"; then
            echo "Error: hpcrun failed"
            # Resume DCGM before exiting
            if command -v dcgmi &> /dev/null; then
                dcgmi profile --resume 2>/dev/null || true
            fi
            return 1
        fi
    else
        echo "Command: hpcrun -e gpu=nvidia -tt -o $measurements_dir $executable"
        if ! hpcrun -e gpu=nvidia -tt -o "$measurements_dir" "$executable"; then
            echo "Error: hpcrun failed"
            # Resume DCGM before exiting
            if command -v dcgmi &> /dev/null; then
                dcgmi profile --resume 2>/dev/null || true
            fi
            return 1
        fi
    fi
    echo ""

    # Step 2: Run hpcstruct
    echo "=== Step 2/3: Running hpcstruct (structure analysis) ==="
    echo "Command: hpcstruct $measurements_dir"
    if ! hpcstruct "$measurements_dir"; then
        echo "Error: hpcstruct failed"
        # Resume DCGM before exiting
        if command -v dcgmi &> /dev/null; then
            dcgmi profile --resume 2>/dev/null || true
        fi
        return 1
    fi
    echo ""

    # Step 3: Run hpcprof
    echo "=== Step 3/3: Running hpcprof (attribution) ==="
    echo "Command: hpcprof -o $database_dir $measurements_dir"
    if ! hpcprof -o "$database_dir" "$measurements_dir"; then
        echo "Error: hpcprof failed"
        # Resume DCGM before exiting
        if command -v dcgmi &> /dev/null; then
            dcgmi profile --resume 2>/dev/null || true
        fi
        return 1
    fi
    echo ""

    # Resume DCGM if available
    if command -v dcgmi &> /dev/null; then
        echo "Resuming DCGM..."
        dcgmi profile --resume 2>/dev/null || true
    fi

    # Success message
    echo "=== HPCToolkit Profiling Complete ==="
    echo "Measurements: $measurements_dir"
    echo "Database: $database_dir"
    echo ""
    echo "Next steps:"
    echo "  1. Analyze with Hatchet: hatchet_analyze $database_dir"
    echo "  2. View with hpcviewer: hpcviewer $database_dir"
    echo ""
}

main "$@"
