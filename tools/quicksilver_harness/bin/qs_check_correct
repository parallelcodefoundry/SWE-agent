#!/usr/bin/env python3
"""
qs_check_correct - Automatically verify correctness of modified Quicksilver.

This tool runs BOTH the pristine (unmodified) and modified Quicksilver with
IDENTICAL parameters, then compares SCIENTIFIC values (scalar_flux, particle
counts) to ensure correctness is preserved.

No file paths needed - everything is automatic.
"""
import argparse
import subprocess
import os
import sys
import json
import re

# Pristine Quicksilver source (unmodified reference)
def _find_pristine_qs():
    root = os.environ.get('PRISTINE_QS_ROOT')
    if root and os.path.isdir(root):
        return root
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Quicksilver')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    return "/global/u2/k/krydzy/SWE-agent/Quicksilver"

PRISTINE_QS_ROOT = _find_pristine_qs()

def get_pristine_executable():
    """Get path to pristine Quicksilver executable, building if needed."""
    exe_path = os.path.join(PRISTINE_QS_ROOT, 'src', 'qs')

    if not os.path.isfile(exe_path):
        print("Building pristine Quicksilver for correctness check...", file=sys.stderr)
        build_result = subprocess.run(
            ['make', '-j8'],
            cwd=os.path.join(PRISTINE_QS_ROOT, 'src'),
            capture_output=True,
            text=True,
            timeout=300
        )
        if build_result.returncode != 0 or not os.path.isfile(exe_path):
            print(f"Failed to build pristine Quicksilver: {build_result.stderr}", file=sys.stderr)
            return None
        print("Pristine build complete.", file=sys.stderr)

    return exe_path

def get_modified_executable():
    """Get path to modified Quicksilver executable."""
    qs_root = os.environ.get('QUICKSILVER_ROOT')
    if not qs_root:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidate_paths = [
            os.path.join(script_dir, '..', '..', '..', 'Quicksilver_test'),
            '/global/u2/k/krydzy/SWE-agent/Quicksilver_test',
        ]
        for path in candidate_paths:
            if os.path.isdir(path):
                qs_root = os.path.abspath(path)
                break

    if not qs_root:
        return None

    exe_path = os.path.join(qs_root, 'src', 'qs')
    return exe_path if os.path.isfile(exe_path) else None

def run_quicksilver(exe_path, args, env, label):
    """Run Quicksilver and return stdout."""
    qs_cmd = [
        exe_path,
        '--lx', str(args.lx),
        '--ly', str(args.ly),
        '--lz', str(args.lz),
        '--nx', str(args.nx),
        '--ny', str(args.ny),
        '--nz', str(args.nz),
        '--nParticles', str(args.nParticles),
        '--nSteps', str(args.nSteps)
    ]

    # Use srun with minimal resources for correctness check
    cmd = [
        'srun', '-N', '1',
        '--ntasks-per-node=1',
    ] + qs_cmd

    print(f"Running {label}...", file=sys.stderr)

    try:
        proc = subprocess.run(
            cmd,
            cwd=os.path.dirname(exe_path),
            capture_output=True,
            text=True,
            timeout=300,
            env=env
        )
        if proc.returncode != 0:
            return None, f"Run failed with return code {proc.returncode}: {proc.stderr[-500:]}"
        return proc.stdout, None
    except subprocess.TimeoutExpired:
        return None, "Run timed out (>5 minutes)"
    except Exception as e:
        return None, str(e)

def extract_values(output_text):
    """Extract SCIENTIFIC values from Quicksilver output for correctness comparison.

    NOTE: This excludes timing/performance metrics like figure_of_merit and main_time_avg
    because those naturally vary between runs and are NOT correctness indicators.
    """
    values = {}

    # Parse cycle table
    # Format: cycle  start  source  rr  split  absorb  scatter  fission  produce  collisn  escape  census  num_seg  scalar_flux
    header_match = re.search(r'cycle\s+start\s+source\s+rr\s+split\s+absorb\s+scatter\s+fission\s+produce\s+collisn\s+escape\s+census\s+num_seg\s+scalar_flux', output_text)

    if header_match:
        # Find all cycle data lines after header
        cycle_pattern = r'^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+([\d.eE+-]+)'

        for match in re.finditer(cycle_pattern, output_text, re.MULTILINE):
            cycle_num = int(match.group(1))
            # Scientific/correctness values only
            values[f'cycle_{cycle_num}_absorb'] = int(match.group(6))
            values[f'cycle_{cycle_num}_scatter'] = int(match.group(7))
            values[f'cycle_{cycle_num}_fission'] = int(match.group(8))
            values[f'cycle_{cycle_num}_collisn'] = int(match.group(10))
            values[f'cycle_{cycle_num}_escape'] = int(match.group(11))
            values[f'cycle_{cycle_num}_census'] = int(match.group(12))
            values[f'cycle_{cycle_num}_num_seg'] = int(match.group(13))
            values[f'cycle_{cycle_num}_scalar_flux'] = float(match.group(14))

    return values

def compare_values(baseline_values, test_values, tolerance):
    """Compare scientific values within tolerance."""
    differences = []
    matched = []

    for key in baseline_values.keys():
        baseline_val = baseline_values[key]
        test_val = test_values.get(key)

        if test_val is None:
            differences.append({
                "key": key,
                "issue": "missing_in_test",
                "baseline_value": baseline_val
            })
        else:
            if isinstance(baseline_val, float):
                if baseline_val == 0:
                    rel_error = abs(test_val) if test_val != 0 else 0
                else:
                    rel_error = abs(test_val - baseline_val) / abs(baseline_val)

                if rel_error > tolerance:
                    differences.append({
                        "key": key,
                        "baseline": baseline_val,
                        "test": test_val,
                        "relative_error": rel_error
                    })
                else:
                    matched.append({
                        "key": key,
                        "baseline": baseline_val,
                        "test": test_val,
                        "relative_error": rel_error
                    })
            else:
                if baseline_val != test_val:
                    differences.append({
                        "key": key,
                        "baseline": baseline_val,
                        "test": test_val,
                        "difference": test_val - baseline_val
                    })
                else:
                    matched.append({
                        "key": key,
                        "baseline": baseline_val,
                        "test": test_val
                    })

    return matched, differences

def main():
    parser = argparse.ArgumentParser(
        description='Automatically check correctness of modified Quicksilver',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
This tool automatically:
  1. Runs pristine (unmodified) Quicksilver
  2. Runs your modified Quicksilver
  3. Compares scientific values (particle counts, scalar flux)

No file paths needed - everything is handled automatically.

Example:
  qs_check_correct                    # Quick check with defaults
  qs_check_correct --nSteps 20        # More steps for thorough check
  qs_check_correct --tolerance 1e-4   # Allow larger floating-point variance
'''
    )
    # Problem size parameters (small defaults for quick checking)
    parser.add_argument('--lx', type=int, default=10, help='Domain size x (default: 10)')
    parser.add_argument('--ly', type=int, default=10, help='Domain size y (default: 10)')
    parser.add_argument('--lz', type=int, default=10, help='Domain size z (default: 10)')
    parser.add_argument('--nx', type=int, default=10, help='Mesh cells x (default: 10)')
    parser.add_argument('--ny', type=int, default=10, help='Mesh cells y (default: 10)')
    parser.add_argument('--nz', type=int, default=10, help='Mesh cells z (default: 10)')
    parser.add_argument('--nParticles', type=int, default=10000, help='Number of particles (default: 10000)')
    parser.add_argument('--nSteps', type=int, default=5, help='Number of steps (default: 5)')
    parser.add_argument('--tolerance', type=float, default=1e-6, help='Relative error tolerance (default: 1e-6)')
    args = parser.parse_args()

    result = {
        "correct": False,
        "parameters": {
            "lx": args.lx, "ly": args.ly, "lz": args.lz,
            "nx": args.nx, "ny": args.ny, "nz": args.nz,
            "nParticles": args.nParticles, "nSteps": args.nSteps
        },
        "tolerance": args.tolerance
    }

    # Get executables
    pristine_exe = get_pristine_executable()
    if not pristine_exe:
        result["error"] = "Could not build/find pristine Quicksilver"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    modified_exe = get_modified_executable()
    if not modified_exe:
        result["error"] = "Modified Quicksilver not found. Run qs_build first."
        print(json.dumps(result, indent=2))
        sys.exit(1)

    result["pristine_executable"] = pristine_exe
    result["modified_executable"] = modified_exe

    # Set up environment
    env = os.environ.copy()
    env['OMP_NUM_THREADS'] = '1'
    env['MPICH_GPU_SUPPORT_ENABLED'] = '0'

    print("=" * 60, file=sys.stderr)
    print("CORRECTNESS CHECK: Comparing modified vs pristine Quicksilver", file=sys.stderr)
    print(f"  Domain: {args.lx}x{args.ly}x{args.lz}, Particles: {args.nParticles}, Steps: {args.nSteps}", file=sys.stderr)
    print("=" * 60, file=sys.stderr)

    # Run pristine version
    pristine_output, pristine_error = run_quicksilver(pristine_exe, args, env, "pristine (reference)")
    if pristine_error:
        result["error"] = f"Pristine run failed: {pristine_error}"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    # Run modified version
    modified_output, modified_error = run_quicksilver(modified_exe, args, env, "modified (your changes)")
    if modified_error:
        result["error"] = f"Modified run failed: {modified_error}"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    # Extract and compare values
    pristine_values = extract_values(pristine_output)
    modified_values = extract_values(modified_output)

    if not pristine_values:
        result["error"] = "No scientific values found in pristine output"
        result["warning"] = "The simulation may have failed or produced no output"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    if not modified_values:
        result["error"] = "No scientific values found in modified output"
        result["warning"] = "Your changes may have broken the simulation"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    matched, differences = compare_values(pristine_values, modified_values, args.tolerance)

    result["values_compared"] = len(matched) + len(differences)
    result["matched"] = len(matched)
    result["correct"] = len(differences) == 0

    if differences:
        result["differences"] = differences[:10] if len(differences) > 10 else differences
        if len(differences) > 10:
            result["total_differences"] = len(differences)
            result["note"] = f"Showing first 10 of {len(differences)} differences"

    # Print summary to stderr
    print("=" * 60, file=sys.stderr)
    if result["correct"]:
        print(f"CORRECT: All {len(matched)} scientific values match within tolerance.", file=sys.stderr)
        result["message"] = f"All {len(matched)} scientific values match within tolerance."
    else:
        print(f"INCORRECT: {len(differences)} values differ from baseline!", file=sys.stderr)
        for diff in differences[:3]:
            print(f"  - {diff['key']}: expected {diff.get('baseline', 'N/A')}, got {diff.get('test', 'N/A')}", file=sys.stderr)
        result["message"] = f"{len(differences)} values differ from baseline"
    print("=" * 60, file=sys.stderr)

    print(json.dumps(result, indent=2))
    sys.exit(0 if result["correct"] else 1)

if __name__ == '__main__':
    main()
