#!/usr/bin/env python3
"""
qs_run - Run Quicksilver benchmark and compare against baseline.

Uses the Coral2_P2_1 benchmark for consistent results.
Reports total runtime and speedup/slowdown - detailed timing is abstracted away
to simulate real-world optimization where profiling tools are needed for deeper analysis.

Runs with MPI across multiple GPUs (one rank per GPU).
Uses mpirun for execution (avoids nested srun hangs in batch mode).
"""
import subprocess
import os
import sys
import json
import re
import argparse
import tempfile
import statistics

# Pristine Quicksilver source (unmodified baseline)
def _find_pristine_qs():
    root = os.environ.get('PRISTINE_QS_ROOT')
    if root and os.path.isdir(root):
        return root
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Quicksilver')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    swe_root = os.environ.get('SWE_AGENT_ROOT')
    if swe_root:
        candidate = os.path.join(swe_root, 'Quicksilver')
        if os.path.isdir(candidate):
            return os.path.abspath(candidate)
    print("ERROR: Pristine Quicksilver not found. Set PRISTINE_QS_ROOT or run setup_apps.sh.", file=sys.stderr)
    return None

PRISTINE_QS_ROOT = _find_pristine_qs()

# Fixed benchmark configuration - Coral2 Problem 2 single-node
BENCHMARK_INPUT = "Examples/CORAL2_Benchmark/Problem2/Coral2_P2_1.inp"

# Default tolerance for correctness checking
DEFAULT_TOLERANCE = 1e-6


def compute_domain_decomposition(np_ranks):
    """Compute xDom, yDom, zDom for a given number of MPI ranks.

    QS requires xDom * yDom * zDom == nRanks.
    """
    if np_ranks == 1:
        return 1, 1, 1
    elif np_ranks == 2:
        return 2, 1, 1
    elif np_ranks == 4:
        return 2, 2, 1
    elif np_ranks == 8:
        return 2, 2, 2
    else:
        # Linear decomposition in x
        return np_ranks, 1, 1


def get_pristine_executable():
    """Get path to pristine Quicksilver executable, building if needed."""
    exe_path = os.path.join(PRISTINE_QS_ROOT, 'src', 'qs')

    if not os.path.isfile(exe_path):
        print("Building pristine Quicksilver for baseline...")
        sys.stdout.flush()
        build_result = subprocess.run(
            ['make', '-j8'],
            cwd=os.path.join(PRISTINE_QS_ROOT, 'src'),
            capture_output=True,
            text=True,
            timeout=300
        )
        if build_result.returncode != 0 or not os.path.isfile(exe_path):
            print(f"Failed to build pristine Quicksilver: {build_result.stderr}")
            return None
        print("Pristine build complete.")

    return exe_path


def make_input_file_for_ranks(input_file, np_ranks):
    """Create a temporary input file with domain decomposition matching np_ranks.

    QS parses the input file AFTER CLI args, so CLI -I/-J/-K get overridden.
    We must modify the input file directly to set xDom/yDom/zDom.
    """
    xDom, yDom, zDom = compute_domain_decomposition(np_ranks)

    with open(input_file, 'r') as f:
        content = f.read()

    # Replace xDom/yDom/zDom values in the input file
    content = re.sub(r'(xDom:\s*)\d+', rf'\g<1>{xDom}', content)
    content = re.sub(r'(yDom:\s*)\d+', rf'\g<1>{yDom}', content)
    content = re.sub(r'(zDom:\s*)\d+', rf'\g<1>{zDom}', content)

    # Write to a temp file in the same directory (so relative paths still work)
    input_dir = os.path.dirname(input_file)
    fd, tmp_path = tempfile.mkstemp(suffix='.inp', dir=input_dir, prefix='qs_bench_')
    with os.fdopen(fd, 'w') as f:
        f.write(content)

    return tmp_path, xDom, yDom, zDom


def run_quicksilver(exe_path, input_file, np_ranks, omp_threads, label="", timeout=300):
    """Run Quicksilver with the benchmark input file using MPI.

    Returns: (total_time_seconds, output_text) or (None, None) on failure
    """
    env = os.environ.copy()
    env['OMP_NUM_THREADS'] = str(omp_threads)
    env['OMP_PROC_BIND'] = 'spread'
    env['OMP_PLACES'] = 'threads'

    # Create modified input file with correct domain decomposition
    tmp_input, xDom, yDom, zDom = make_input_file_for_ranks(input_file, np_ranks)

    try:
        qs_cmd = [exe_path, '-i', tmp_input]

        # Always use mpirun for MPI execution (avoids nested srun hangs in batch mode).
        # --oversubscribe: PRRTE/OpenMPI 5 may see only 1 slot from SLURM srun;
        #   this allows launching more ranks than detected slots.
        # --bind-to none: let CUDA_VISIBLE_DEVICES handle GPU assignment.
        # Per-rank GPU isolation via OMPI_COMM_WORLD_LOCAL_RANK (same as kripke_run).
        if np_ranks > 1:
            cmd = ['mpirun', '-np', str(np_ranks), '--bind-to', 'none', '--oversubscribe',
                   'bash', '-c', 'export CUDA_VISIBLE_DEVICES=$OMPI_COMM_WORLD_LOCAL_RANK; exec "$@"',
                   '--'] + qs_cmd
        else:
            cmd = ['mpirun', '-np', '1', '--bind-to', 'none', '--oversubscribe'] + qs_cmd

        if label:
            print(f"Running {label}...")
            print(f"  Command: {' '.join(cmd)}", file=sys.stderr)
            print(f"  OMP_NUM_THREADS={omp_threads}, MPI ranks={np_ranks}", file=sys.stderr)
            print(f"  Domain decomposition: {xDom}x{yDom}x{zDom}", file=sys.stderr)
            sys.stdout.flush()

        proc = subprocess.run(
            cmd,
            cwd=os.path.dirname(exe_path),
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env
        )

        if proc.returncode == 0:
            # Extract total time from 'main' timer
            # Format: "main  1  min_us  avg_us  max_us  stddev_us  efficiency"
            timer_pattern = r'^main\s+\d+\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)'
            for line in proc.stdout.split('\n'):
                match = re.match(timer_pattern, line)
                if match:
                    max_us = float(match.group(3))  # Use max time
                    total_seconds = max_us / 1e6
                    return total_seconds, proc.stdout

            print("Warning: Could not parse timing from output")
            return None, proc.stdout
        else:
            print(f"Run failed (exit code {proc.returncode}): {proc.stderr[-500:]}")
            return None, None

    except subprocess.TimeoutExpired:
        print("Run timed out (>5 minutes)")
        return None, None
    except Exception as e:
        print(f"Run error: {e}")
        return None, None
    finally:
        # Clean up temp input file
        try:
            os.unlink(tmp_input)
        except OSError:
            pass


def extract_scientific_values(output_text):
    """Extract scientific values from Quicksilver output for correctness comparison.

    Only extracts physics values (absorb, scatter, fission, etc.) - NOT timing.
    """
    values = {}

    # Parse cycle table for scientific values
    cycle_pattern = r'^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+([\d.eE+-]+)'

    for match in re.finditer(cycle_pattern, output_text, re.MULTILINE):
        cycle_num = int(match.group(1))
        values[f'cycle_{cycle_num}_absorb'] = int(match.group(6))
        values[f'cycle_{cycle_num}_scatter'] = int(match.group(7))
        values[f'cycle_{cycle_num}_fission'] = int(match.group(8))
        values[f'cycle_{cycle_num}_collisn'] = int(match.group(10))
        values[f'cycle_{cycle_num}_escape'] = int(match.group(11))
        values[f'cycle_{cycle_num}_census'] = int(match.group(12))
        values[f'cycle_{cycle_num}_scalar_flux'] = float(match.group(14))

    return values


def check_correctness(baseline_output, modified_output, tolerance=DEFAULT_TOLERANCE):
    """Compare scientific values between baseline and modified outputs."""
    baseline_values = extract_scientific_values(baseline_output)
    modified_values = extract_scientific_values(modified_output)

    if not baseline_values:
        return {"correct": False, "error": "No scientific values found in baseline output"}
    if not modified_values:
        return {"correct": False, "error": "No scientific values found in modified output"}

    differences = []
    matched = 0

    for key in baseline_values.keys():
        baseline_val = baseline_values[key]
        modified_val = modified_values.get(key)

        if modified_val is None:
            differences.append({"key": key, "issue": "missing_in_modified", "baseline": baseline_val})
        elif isinstance(baseline_val, float):
            if baseline_val == 0:
                rel_error = abs(modified_val) if modified_val != 0 else 0
            else:
                rel_error = abs(modified_val - baseline_val) / abs(baseline_val)

            if rel_error > tolerance:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "relative_error": rel_error
                })
            else:
                matched += 1
        else:
            if baseline_val != modified_val:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "difference": modified_val - baseline_val
                })
            else:
                matched += 1

    return {
        "correct": len(differences) == 0,
        "matched": matched,
        "total_values": len(baseline_values),
        "differences": differences[:5] if differences else [],
        "total_differences": len(differences)
    }


def main():
    parser = argparse.ArgumentParser(description='Run Quicksilver benchmark (MPI + CUDA, multi-GPU)')
    parser.add_argument('--np', type=int, default=1, help='Number of MPI ranks (default: 1, single GPU)')
    parser.add_argument('--omp-threads', type=int, default=8, help='OpenMP threads per rank (default: 8)')
    parser.add_argument('--baseline-only', action='store_true',
                       help='Only run the baseline (pristine) version to establish reference timing. '
                            'Use this before making changes to understand the baseline performance.')
    parser.add_argument('--timing-runs', type=int, default=1,
                       help='Number of timing runs for each version (default: 1). Reports median time.')
    parser.add_argument('--timeout-multiplier', type=float, default=3.0,
                       help='Modified run timeout = baseline_time * multiplier (default: 3.0)')
    args = parser.parse_args()

    # Find modified Quicksilver executable
    qs_root = os.environ.get('QUICKSILVER_ROOT')
    if not qs_root:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidate = os.path.join(script_dir, '..', '..', '..', 'Quicksilver_test')
        if os.path.isdir(candidate):
            qs_root = os.path.abspath(candidate)

    modified_exe = os.path.join(qs_root, 'src', 'qs') if qs_root else None

    if not modified_exe or not os.path.isfile(modified_exe):
        print("=" * 60)
        print("ERROR: Quicksilver executable not found.")
        print("Run qs_build first to compile the application.")
        print("=" * 60)
        sys.exit(1)

    # Get pristine executable for baseline
    pristine_exe = get_pristine_executable()
    if not pristine_exe:
        print("=" * 60)
        print("ERROR: Could not build baseline Quicksilver.")
        print("=" * 60)
        sys.exit(1)

    input_file = os.path.join(PRISTINE_QS_ROOT, BENCHMARK_INPUT)
    if not os.path.isfile(input_file):
        print("=" * 60)
        print(f"ERROR: Benchmark input file not found: {input_file}")
        print("=" * 60)
        sys.exit(1)

    xDom, yDom, zDom = compute_domain_decomposition(args.np)

    print("=" * 60)
    print("QUICKSILVER BENCHMARK: Coral2_P2_1")
    cuda_devices = os.environ.get('CUDA_VISIBLE_DEVICES', 'all available')
    print(f"Using GPUs: {cuda_devices}")
    print(f"MPI ranks: {args.np}, OMP threads: {args.omp_threads}")
    print(f"Domain decomposition: {xDom}x{yDom}x{zDom}")
    print("=" * 60)
    sys.stdout.flush()

    num_runs = args.timing_runs

    # --- Warmup run (discarded) ---
    # First CUDA execution on a fresh node is slow (context init, Lustre page cache).
    # Run once to warm up before collecting timing data.
    print("Warmup run (discarded)...")
    sys.stdout.flush()
    warmup_t, _ = run_quicksilver(pristine_exe, input_file, args.np, args.omp_threads, "warmup")
    if warmup_t is None:
        print("WARNING: Warmup run failed, proceeding anyway.")
    else:
        print(f"Warmup complete ({warmup_t:.2f}s)")
    sys.stdout.flush()

    # --- Baseline runs ---
    baseline_times = []
    baseline_output = None

    for i in range(num_runs):
        run_label = f"baseline run {i+1}/{num_runs}" if num_runs > 1 else "baseline (unmodified)"
        t, output = run_quicksilver(
            pristine_exe, input_file, args.np, args.omp_threads, run_label
        )
        if t is None:
            if i == 0:
                print("=" * 60)
                print("ERROR: Baseline run failed.")
                print("=" * 60)
                sys.exit(1)
            print(f"  Baseline run {i+1} failed. Using {len(baseline_times)} successful runs.")
            break
        baseline_times.append(t)
        if i == 0:
            baseline_output = output

    baseline_time = statistics.median(baseline_times)

    if args.baseline_only:
        # Baseline-only mode: just report baseline timing, no comparison
        print("=" * 60)
        print("QUICKSILVER BASELINE RESULTS")
        print("=" * 60)
        print()
        if num_runs > 1:
            print(f"BASELINE RUNS:   {len(baseline_times)}")
            for i, t in enumerate(baseline_times):
                print(f"  Run {i+1}: {t:.2f}s")
            print(f"BASELINE TIME:   {baseline_time:.2f} seconds (median)")
        else:
            print(f"BASELINE TIME:   {baseline_time:.2f} seconds")
        print()
        print("This is the reference timing from the unmodified application.")
        print("Make your optimizations, rebuild with qs_build, then run qs_run (without --baseline-only)")
        print("to compare your modified version against this baseline.")
        print("=" * 60)
        return

    # --- Modified runs ---
    modified_timeout = max(baseline_time * args.timeout_multiplier, 60)
    modified_times = []
    modified_output = None
    timed_out = False

    for i in range(num_runs):
        run_label = f"modified run {i+1}/{num_runs}" if num_runs > 1 else "modified version"
        t, output = run_quicksilver(
            modified_exe, input_file, args.np, args.omp_threads, run_label,
            timeout=modified_timeout
        )
        if t is None:
            if i == 0:
                print("=" * 60)
                print("CORRECTNESS:  FAILED (modified version crashed or failed to run)")
                print()
                print("ERROR: Modified version run failed.")
                print("The binary may have segfaulted, timed out, or produced no output.")
                print("Check your changes and rebuild with qs_build.")
                print("=" * 60)
                sys.exit(1)
            print(f"  Modified run {i+1} failed/timed out. Stopping early.")
            timed_out = True
            break
        modified_times.append(t)
        if i == 0:
            modified_output = output
        # Early stopping: if this run is way slower than baseline
        if t > baseline_time * args.timeout_multiplier:
            if num_runs > 1:
                print(f"  Run {i+1} time ({t:.1f}s) exceeds {args.timeout_multiplier:.0f}x baseline ({baseline_time:.1f}s). Stopping early.")
            timed_out = True
            break

    modified_time = statistics.median(modified_times)

    # Check correctness (first run outputs only)
    correctness = check_correctness(baseline_output, modified_output)

    # Calculate speedup
    speedup = baseline_time / modified_time if modified_time > 0 else 0

    # Print results (this is what the model sees)
    print("=" * 60)
    print("QUICKSILVER BENCHMARK RESULTS")
    print("=" * 60)
    print()

    # Correctness
    if correctness.get('correct'):
        print(f"CORRECTNESS:  PASSED ({correctness.get('matched', 0)} physics values verified)")
    else:
        print(f"CORRECTNESS:  FAILED ({correctness.get('total_differences', 0)} values differ!)")
        for diff in correctness.get('differences', [])[:3]:
            print(f"  - {diff.get('key')}: expected {diff.get('baseline')}, got {diff.get('modified')}")
    print()

    # Performance (simplified - no detailed breakdown)
    print(f"BASELINE TIME:   {baseline_time:.2f} seconds")
    print(f"MODIFIED TIME:   {modified_time:.2f} seconds")

    if num_runs > 1:
        print(f"TIMING RUNS:     {len(baseline_times)} baseline, {len(modified_times)} modified")
        print(f"  Baseline per-run: {', '.join(f'{t:.2f}' for t in baseline_times)}")
        print(f"  Modified per-run: {', '.join(f'{t:.2f}' for t in modified_times)}")
        if len(baseline_times) > 1:
            print(f"  Baseline stdev:   {statistics.stdev(baseline_times):.2f}s")
        if len(modified_times) > 1:
            print(f"  Modified stdev:   {statistics.stdev(modified_times):.2f}s")
        if timed_out:
            print(f"  NOTE: Modified runs stopped early (exceeded {args.timeout_multiplier:.0f}x baseline)")
    print()

    if speedup > 1.0:
        print(f"RESULT:          {speedup:.2f}x SPEEDUP")
        print(f"TIME SAVED:      {baseline_time - modified_time:.2f} seconds")
    elif speedup < 1.0:
        slowdown = 1.0 / speedup
        print(f"RESULT:          {slowdown:.2f}x SLOWDOWN")
        print(f"TIME ADDED:      {modified_time - baseline_time:.2f} seconds")
    else:
        print("RESULT:          NO CHANGE")

    print()
    print("=" * 60)

    # Determine exit status
    if not correctness.get('correct'):
        print("Status: FAILED (correctness check failed)")
        sys.exit(1)
    elif speedup >= 1.0:
        print("Status: SUCCESS")
        sys.exit(0)
    else:
        print("Status: REGRESSION (slower than baseline)")
        sys.exit(0)  # Don't fail on slowdown, just report it


if __name__ == '__main__':
    main()
