#!/usr/bin/env python3
"""
microbench_code - Compile and run standalone code snippets for quick timing experiments.
"""
import argparse
import subprocess
import os
import sys
import json
import tempfile
import time
import statistics

def get_compiler_for_extension(filename):
    """Determine default compiler based on file extension."""
    ext = os.path.splitext(filename)[1].lower()
    compilers = {
        '.cu': 'nvcc',
        '.cpp': 'g++',
        '.cxx': 'g++',
        '.cc': 'g++',
        '.c': 'gcc',
        '.hip': 'hipcc',
    }
    return compilers.get(ext, 'g++')

def get_default_flags(compiler):
    """Get default compiler flags."""
    if compiler == 'nvcc':
        return '-O3 -arch=sm_80'
    elif compiler in ('g++', 'gcc'):
        return '-O3 -march=native'
    elif compiler == 'hipcc':
        return '-O3'
    return '-O3'

def compile_code(source_file, compiler, flags, output_exe):
    """Compile the source file."""
    cmd = [compiler] + flags.split() + [source_file, '-o', output_exe]

    proc = subprocess.run(cmd, capture_output=True, text=True)
    return proc.returncode == 0, proc.stderr

def run_benchmark(exe_path, repeat):
    """Run the executable multiple times and collect timing."""
    times = []

    for i in range(repeat):
        start = time.perf_counter()
        proc = subprocess.run([exe_path], capture_output=True, text=True, timeout=60)
        elapsed = time.perf_counter() - start

        if proc.returncode != 0:
            return None, f"Execution failed on iteration {i+1}: {proc.stderr[-500:]}"

        # Check if the program reports its own timing
        # Look for patterns like "Time: X.XXX ms" or "Elapsed: X.XXX"
        import re
        match = re.search(r'(?:time|elapsed|duration)[:\s]*([0-9.]+)\s*(?:ms|milliseconds)',
                         proc.stdout, re.IGNORECASE)
        if match:
            times.append(float(match.group(1)))
        else:
            # Use wall-clock time in milliseconds
            times.append(elapsed * 1000)

    return times, None

def main():
    parser = argparse.ArgumentParser(description='Microbenchmark code snippets')
    parser.add_argument('code_file', help='Path to source code file')
    parser.add_argument('--compiler', help='Compiler command (default: auto-detect from extension)')
    parser.add_argument('--flags', help='Compiler flags (default: -O3)')
    parser.add_argument('--repeat', type=int, default=5, help='Number of timing iterations')
    args = parser.parse_args()

    if not os.path.isfile(args.code_file):
        print(json.dumps({
            "success": False,
            "error": f"Source file not found: {args.code_file}"
        }))
        sys.exit(1)

    compiler = args.compiler or get_compiler_for_extension(args.code_file)
    flags = args.flags or get_default_flags(compiler)

    result = {
        "success": False,
        "source_file": args.code_file,
        "compiler": compiler,
        "flags": flags,
        "repeat": args.repeat
    }

    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            exe_path = os.path.join(tmpdir, 'benchmark_exe')

            # Compile
            compile_success, compile_error = compile_code(
                args.code_file, compiler, flags, exe_path
            )

            result["compile_success"] = compile_success

            if not compile_success:
                result["error"] = f"Compilation failed: {compile_error[-1000:]}"
                print(json.dumps(result, indent=2))
                sys.exit(1)

            # Run benchmarks
            times, run_error = run_benchmark(exe_path, args.repeat)

            if run_error:
                result["error"] = run_error
                print(json.dumps(result, indent=2))
                sys.exit(1)

            # Calculate statistics
            result["times_ms"] = times
            result["mean_ms"] = statistics.mean(times)
            result["min_ms"] = min(times)
            result["max_ms"] = max(times)

            if len(times) > 1:
                result["stddev_ms"] = statistics.stdev(times)
            else:
                result["stddev_ms"] = 0.0

            result["success"] = True

    except subprocess.TimeoutExpired:
        result["error"] = "Execution timed out (>60 seconds per iteration)"
    except Exception as e:
        result["error"] = str(e)

    print(json.dumps(result, indent=2))
    sys.exit(0 if result["success"] else 1)

if __name__ == '__main__':
    main()
