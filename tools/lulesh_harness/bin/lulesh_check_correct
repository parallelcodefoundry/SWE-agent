#!/usr/bin/env python3
"""
lulesh_check_correct - Quick correctness verification for LULESH.

Runs a smaller problem to quickly verify correctness before running
full benchmarks.
"""
import subprocess
import os
import sys
import json
import re

# Pristine LULESH source (unmodified baseline)
def _find_pristine_lulesh():
    root = os.environ.get('PRISTINE_LULESH_ROOT')
    if root and os.path.isdir(root):
        return root
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Lulesh', 'cuda')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    return "/global/u2/k/krydzy/SWE-agent/Lulesh/cuda"

PRISTINE_LULESH_ROOT = _find_pristine_lulesh()

# Quick check parameters (smaller for faster verification)
DEFAULT_SIZE = 20
DEFAULT_ITERATIONS = 50
DEFAULT_TOLERANCE = 1e-8


def find_cuda_path():
    """Find CUDA installation path."""
    cuda_home = os.environ.get('CUDA_HOME') or os.environ.get('CUDATOOLKIT_HOME')
    if cuda_home and os.path.isdir(cuda_home):
        return cuda_home
    candidates = [
        '/opt/nvidia/hpc_sdk/Linux_x86_64/24.5/cuda/12.4',
        '/usr/local/cuda',
    ]
    for path in candidates:
        if os.path.isdir(path):
            return path
    return None


def get_pristine_executable():
    """Get path to pristine LULESH executable, building if needed."""
    exe_path = os.path.join(PRISTINE_LULESH_ROOT, 'lulesh')

    if not os.path.isfile(exe_path):
        print("Building pristine LULESH...")
        cuda_path = find_cuda_path()
        build_env = os.environ.copy()
        if cuda_path:
            build_env['CUDATOOLKIT_HOME'] = cuda_path

        build_result = subprocess.run(
            ['make', '-j8'],
            cwd=PRISTINE_LULESH_ROOT,
            capture_output=True,
            text=True,
            timeout=300,
            env=build_env
        )
        if build_result.returncode != 0 or not os.path.isfile(exe_path):
            return None

    return exe_path


def run_lulesh(exe_path, size, iterations):
    """Run LULESH and extract scientific values."""
    env = os.environ.copy()
    env['CUDA_VISIBLE_DEVICES'] = '0'
    env['OMP_NUM_THREADS'] = '1'

    cmd = [exe_path, '-s', str(size), '-i', str(iterations)]

    try:
        proc = subprocess.run(
            cmd,
            cwd=os.path.dirname(exe_path),
            capture_output=True,
            text=True,
            timeout=300,
            env=env
        )

        if proc.returncode == 0:
            return proc.stdout
        return None

    except Exception:
        return None


def extract_values(output_text):
    """Extract scientific values from output."""
    values = {}
    if not output_text:
        return values

    energy_match = re.search(r'Final Origin Energy\s*=\s*([\d.eE+-]+)', output_text)
    if energy_match:
        values['final_origin_energy'] = float(energy_match.group(1))

    return values


def main():
    import argparse
    parser = argparse.ArgumentParser(description='Quick LULESH correctness check')
    parser.add_argument('-s', '--size', type=int, default=DEFAULT_SIZE,
                       help=f'Problem size (default: {DEFAULT_SIZE})')
    parser.add_argument('-i', '--iterations', type=int, default=DEFAULT_ITERATIONS,
                       help=f'Iterations (default: {DEFAULT_ITERATIONS})')
    parser.add_argument('--tolerance', type=float, default=DEFAULT_TOLERANCE,
                       help=f'Tolerance (default: {DEFAULT_TOLERANCE})')
    args = parser.parse_args()

    result = {
        "correct": False,
        "size": args.size,
        "iterations": args.iterations,
        "tolerance": args.tolerance
    }

    # Find modified LULESH
    lulesh_root = os.environ.get('LULESH_ROOT')
    if not lulesh_root:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidate_paths = [
            os.path.join(script_dir, '..', '..', '..', 'Lulesh_test', 'cuda'),
            '/global/u2/k/krydzy/SWE-agent/Lulesh_test/cuda',
        ]
        for path in candidate_paths:
            if os.path.isdir(path):
                lulesh_root = os.path.abspath(path)
                break

    modified_exe = os.path.join(lulesh_root, 'lulesh') if lulesh_root else None
    if not modified_exe or not os.path.isfile(modified_exe):
        result["error"] = "Modified LULESH not found. Run lulesh_build first."
        print(json.dumps(result, indent=2))
        sys.exit(1)

    pristine_exe = get_pristine_executable()
    if not pristine_exe:
        result["error"] = "Could not build pristine LULESH."
        print(json.dumps(result, indent=2))
        sys.exit(1)

    # Run both versions
    print(f"Running correctness check (size={args.size}, iter={args.iterations})...")

    baseline_output = run_lulesh(pristine_exe, args.size, args.iterations)
    modified_output = run_lulesh(modified_exe, args.size, args.iterations)

    if not baseline_output:
        result["error"] = "Baseline run failed"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    if not modified_output:
        result["error"] = "Modified run failed"
        print(json.dumps(result, indent=2))
        sys.exit(1)

    baseline_values = extract_values(baseline_output)
    modified_values = extract_values(modified_output)

    result["baseline_values"] = baseline_values
    result["modified_values"] = modified_values

    # Compare
    differences = []
    for key in baseline_values:
        baseline_val = baseline_values[key]
        modified_val = modified_values.get(key)

        if modified_val is None:
            differences.append({"key": key, "issue": "missing"})
        elif isinstance(baseline_val, float):
            if baseline_val == 0:
                rel_error = abs(modified_val)
            else:
                rel_error = abs(modified_val - baseline_val) / abs(baseline_val)

            if rel_error > args.tolerance:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "relative_error": rel_error
                })

    result["correct"] = len(differences) == 0
    result["differences"] = differences

    print(json.dumps(result, indent=2))
    sys.exit(0 if result["correct"] else 1)


if __name__ == '__main__':
    main()
