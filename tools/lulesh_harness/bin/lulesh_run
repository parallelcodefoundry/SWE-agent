#!/usr/bin/env python3
"""
lulesh_run - Run LULESH benchmark and compare against baseline.

LULESH is a shock hydrodynamics proxy application. It outputs final energy
values that can be used for correctness verification.

Runs on 4 GPUs by default (np=8, 2 ranks per GPU). Lulesh requires a
perfect cube number of MPI ranks (1, 8, 27, 64, ...). np=8 is the smallest
perfect cube that utilizes all 4 A100 GPUs.
"""
import subprocess
import os
import sys
import json
import re
import time
import statistics
import shutil


def _find_mpirun():
    """Resolve mpirun to an absolute path for subprocess robustness."""
    path = shutil.which('mpirun')
    if path:
        return path
    fallback = '/global/common/software/nersc/pe/gpu/gnu/openmpi/5.0.7/bin/mpirun'
    if os.path.isfile(fallback):
        return fallback
    return 'mpirun'

MPIRUN = _find_mpirun()

# Critical library directories for MPI+CUDA on Perlmutter.
_CRITICAL_LIB_DIRS = [
    '/global/common/software/nersc/pe/gpu/gnu/openmpi/5.0.7/lib',
    '/opt/cray/libfabric/1.22.0/lib64',
    '/opt/cray/pe/lib64',
]
_CUDA_LIB_CANDIDATES = [
    '/opt/nvidia/hpc_sdk/Linux_x86_64/24.5/cuda/12.4/lib64',
    '/opt/nvidia/hpc_sdk/Linux_x86_64/25.5/cuda/12.9/lib64',
]

def _ensure_ld_library_path(env):
    """Add critical library dirs to LD_LIBRARY_PATH if missing."""
    ld_path = env.get('LD_LIBRARY_PATH', '')
    dirs = ld_path.split(':') if ld_path else []
    for d in _CRITICAL_LIB_DIRS:
        if os.path.isdir(d) and d not in dirs:
            dirs.append(d)
    has_cuda = any('cuda' in d.lower() for d in dirs)
    if not has_cuda:
        for d in _CUDA_LIB_CANDIDATES:
            if os.path.isdir(d):
                dirs.append(d)
                break
    env['LD_LIBRARY_PATH'] = ':'.join(dirs)
    return env

# Default MPI configuration — 8 ranks across 4 GPUs (2 ranks per GPU).
# Lulesh requires perfect cube number of ranks (1, 8, 27, 64, ...).
# np=8 is the smallest perfect cube that uses all 4 A100 GPUs.
DEFAULT_NP = 8

# Pristine LULESH source (unmodified baseline)
def _find_pristine_lulesh():
    root = os.environ.get('PRISTINE_LULESH_ROOT')
    if root and os.path.isdir(root):
        return root
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Lulesh', 'cuda')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    swe_root = os.environ.get('SWE_AGENT_ROOT')
    if swe_root:
        candidate = os.path.join(swe_root, 'Lulesh', 'cuda')
        if os.path.isdir(candidate):
            return os.path.abspath(candidate)
    print("ERROR: Pristine Lulesh not found. Set PRISTINE_LULESH_ROOT or run setup_apps.sh.", file=sys.stderr)
    return None

PRISTINE_LULESH_ROOT = _find_pristine_lulesh()

# Default test parameters — tuned for ~24s wall time on A100 (s=150, i=5000, np=1)
DEFAULT_SIZE = 150  # Problem size (elements per side)
DEFAULT_ITERATIONS = 5000  # Number of iterations

# Default tolerance for correctness checking
DEFAULT_TOLERANCE = 1e-8

# GPU targeting (use all available GPUs by default, can override via --gpu or CUDA_VISIBLE_DEVICES)
TARGET_GPU = None


def find_cuda_path():
    """Find CUDA installation path."""
    cuda_home = os.environ.get('CUDA_HOME') or os.environ.get('CUDATOOLKIT_HOME')
    if cuda_home and os.path.isdir(cuda_home):
        return cuda_home
    candidates = [
        '/opt/nvidia/hpc_sdk/Linux_x86_64/24.5/cuda/12.4',
        '/opt/nvidia/hpc_sdk/Linux_x86_64/23.9/cuda/12.2',
        '/usr/local/cuda',
    ]
    for path in candidates:
        if os.path.isdir(path):
            return path
    return None


def ensure_pristine_makefile():
    """Ensure Makefile exists in pristine LULESH directory."""
    makefile_path = os.path.join(PRISTINE_LULESH_ROOT, 'Makefile')
    if os.path.isfile(makefile_path):
        return True

    # Makefile template for Perlmutter A100 with MPI support
    makefile_content = '''# LULESH 2.0 CUDA Makefile for Perlmutter (NVIDIA A100 GPUs)
# MPI enabled by default for multi-GPU execution
CUDA_HOME ?= $(CUDATOOLKIT_HOME)
NVCC = $(CUDA_HOME)/bin/nvcc
CUDA_ARCH = sm_80
HOST_CXX ?= $(shell which g++-12 2>/dev/null || which g++-11 2>/dev/null || echo g++)
USE_MPI ?= 1

NVCC_FLAGS = -arch=$(CUDA_ARCH) -O3 -std=c++11 -lineinfo
NVCC_FLAGS += --compiler-bindir=$(HOST_CXX)
NVCC_FLAGS += -Xcompiler -fopenmp

ifeq ($(USE_MPI),1)
    MPI_FLAGS = -DUSE_MPI
    MPI_INCLUDES = -I$(MPICH_DIR)/include
    MPI_LIBS = -L$(MPICH_DIR)/lib -lmpi
else
    MPI_FLAGS =
    MPI_INCLUDES =
    MPI_LIBS =
endif

INCLUDES = -I./src $(MPI_INCLUDES)
LIBS = -L$(CUDA_HOME)/lib64 -lcudart -lgomp $(MPI_LIBS)

SRC_DIR = src
SRCS = $(SRC_DIR)/allocator.cu $(SRC_DIR)/lulesh.cu
ifeq ($(USE_MPI),1)
    SRCS += $(SRC_DIR)/lulesh-comms.cu $(SRC_DIR)/lulesh-comms-gpu.cu
endif
OBJS = $(SRCS:.cu=.o)
TARGET = lulesh

all: release
release: NVCC_FLAGS += -DNDEBUG
release: $(TARGET)

$(TARGET): $(OBJS)
\t$(NVCC) $(NVCC_FLAGS) $(MPI_FLAGS) -o $@ $^ $(LIBS)

$(SRC_DIR)/%.o: $(SRC_DIR)/%.cu
\t$(NVCC) $(NVCC_FLAGS) $(MPI_FLAGS) $(INCLUDES) -c $< -o $@

clean:
\trm -f $(SRC_DIR)/*.o $(TARGET)

.PHONY: all release clean
'''
    try:
        with open(makefile_path, 'w') as f:
            f.write(makefile_content.replace('\\t', '\t'))
        print(f"Created Makefile at {makefile_path}")
        return True
    except Exception as e:
        print(f"Failed to create Makefile: {e}")
        return False


def get_pristine_executable():
    """Get path to pristine LULESH executable, building if needed."""
    exe_path = os.path.join(PRISTINE_LULESH_ROOT, 'lulesh')

    if not os.path.isfile(exe_path):
        print("Building pristine LULESH for baseline...")
        sys.stdout.flush()

        # Ensure Makefile exists
        if not ensure_pristine_makefile():
            print("Failed to ensure Makefile exists")
            return None

        cuda_path = find_cuda_path()
        build_env = os.environ.copy()
        if cuda_path:
            build_env['CUDATOOLKIT_HOME'] = cuda_path

        # Ensure MPICH_DIR is set — Makefile uses it for MPI paths but
        # Perlmutter uses OpenMPI (sets OPENMPI_ROOT instead).
        if not build_env.get('MPICH_DIR'):
            openmpi_root = build_env.get('OPENMPI_ROOT', '')
            fallback = '/global/common/software/nersc/pe/gpu/gnu/openmpi/5.0.7'
            mpi_dir = openmpi_root or (fallback if os.path.isdir(fallback) else '')
            if mpi_dir:
                build_env['MPICH_DIR'] = mpi_dir

        build_result = subprocess.run(
            ['make', '-j8', 'USE_MPI=1'],
            cwd=PRISTINE_LULESH_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            timeout=300,
            env=build_env
        )
        if build_result.returncode != 0 or not os.path.isfile(exe_path):
            print(f"Failed to build pristine LULESH: {build_result.stderr}")
            return None
        print("Pristine build complete.")

    return exe_path


def validate_np_is_cube(np_ranks):
    """Check that np_ranks is a perfect cube (required by Lulesh's domain decomposition)."""
    cube_root = round(np_ranks ** (1.0/3.0))
    if cube_root ** 3 != np_ranks:
        valid = [i**3 for i in range(1, 8)]
        print(f"ERROR: Lulesh requires a perfect cube number of MPI ranks.", file=sys.stderr)
        print(f"  Got: {np_ranks}. Valid values: {valid}", file=sys.stderr)
        return False
    return True


def run_lulesh(exe_path, size, iterations, np_ranks=DEFAULT_NP, label="", timeout=600):
    """Run LULESH with specified parameters.

    Uses mpirun for multi-GPU execution. Lulesh requires a perfect cube number
    of MPI ranks (1, 8, 27, 64, ...) for its 3D domain decomposition.

    Returns: (total_time_seconds, final_energy, output_text) or (None, None, None) on failure
    """
    env = os.environ.copy()
    _ensure_ld_library_path(env)
    # Use specific GPU if set, otherwise inherit from environment (all available)
    if TARGET_GPU is not None:
        env['CUDA_VISIBLE_DEVICES'] = TARGET_GPU
    env['OMP_NUM_THREADS'] = '1'

    lulesh_cmd = [exe_path, '-s', str(size), '-i', str(iterations)]

    # Wrap with mpirun for multi-GPU execution.
    # --oversubscribe: PRRTE/OpenMPI 5 may see only 1 slot from SLURM srun.
    # --bind-to none: let CUDA_VISIBLE_DEVICES handle GPU assignment.
    # Per-rank GPU isolation. Lulesh uses np=8 (2 ranks per GPU on 4 GPUs).
    # Map: ranks 0,1 → GPU 0; ranks 2,3 → GPU 1; ranks 4,5 → GPU 2; ranks 6,7 → GPU 3.
    # Requires all 4 GPUs — fewer GPUs is a benchmark infrastructure error.
    num_gpus = 4
    if np_ranks > 1:
        cmd = [MPIRUN, '-np', str(np_ranks), '--bind-to', 'none', '--oversubscribe',
               'bash', '-c',
               f'export CUDA_VISIBLE_DEVICES=$(($OMPI_COMM_WORLD_LOCAL_RANK * {num_gpus} / {np_ranks})); exec "$@"',
               '--'] + lulesh_cmd
    else:
        cmd = lulesh_cmd

    try:
        if label:
            print(f"Running {label} (MPI ranks={np_ranks})...")
            print(f"  Command: {' '.join(cmd)}", file=sys.stderr)
            sys.stdout.flush()

        start_time = time.time()
        proc = subprocess.run(
            cmd,
            cwd=os.path.dirname(exe_path),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            timeout=timeout,
            env=env
        )
        elapsed = time.time() - start_time

        if proc.returncode == 0:
            # Extract final energy from output
            # LULESH prints: "Final Origin Energy =  X.XXXXXXXXXXXXXXXX"
            energy_match = re.search(r'Final Origin Energy\s*=\s*([\d.eE+-]+)', proc.stdout)
            final_energy = float(energy_match.group(1)) if energy_match else None

            # Use wall-clock elapsed time for accurate measurement
            # (LULESH's internal timer can be very small for quick runs)
            return elapsed, final_energy, proc.stdout
        else:
            print(f"Run failed: {proc.stderr[-500:]}")
            return None, None, None

    except subprocess.TimeoutExpired:
        print("Run timed out (>10 minutes)")
        return None, None, None
    except Exception as e:
        print(f"Run error: {e}")
        return None, None, None


def extract_scientific_values(output_text):
    """Extract scientific values from LULESH output for correctness comparison."""
    values = {}

    if not output_text:
        return values

    # Final Origin Energy
    energy_match = re.search(r'Final Origin Energy\s*=\s*([\d.eE+-]+)', output_text)
    if energy_match:
        values['final_origin_energy'] = float(energy_match.group(1))

    # MaxAbsDiff (if present)
    diff_match = re.search(r'MaxAbsDiff\s*=\s*([\d.eE+-]+)', output_text)
    if diff_match:
        values['max_abs_diff'] = float(diff_match.group(1))

    # TotalAbsDiff (if present)
    total_diff_match = re.search(r'TotalAbsDiff\s*=\s*([\d.eE+-]+)', output_text)
    if total_diff_match:
        values['total_abs_diff'] = float(total_diff_match.group(1))

    # MaxRelDiff (if present)
    rel_diff_match = re.search(r'MaxRelDiff\s*=\s*([\d.eE+-]+)', output_text)
    if rel_diff_match:
        values['max_rel_diff'] = float(rel_diff_match.group(1))

    # Problem size
    size_match = re.search(r'Problem size\s*=\s*(\d+)', output_text)
    if size_match:
        values['problem_size'] = int(size_match.group(1))

    # Iteration count
    iter_match = re.search(r'Iteration count\s*=\s*(\d+)', output_text)
    if iter_match:
        values['iteration_count'] = int(iter_match.group(1))

    return values


def check_correctness(baseline_output, modified_output, tolerance=DEFAULT_TOLERANCE):
    """Compare scientific values between baseline and modified outputs."""
    baseline_values = extract_scientific_values(baseline_output)
    modified_values = extract_scientific_values(modified_output)

    if not baseline_values:
        return {"correct": False, "error": "No scientific values found in baseline output"}
    if not modified_values:
        return {"correct": False, "error": "No scientific values found in modified output"}

    differences = []
    matched = 0

    for key in baseline_values.keys():
        baseline_val = baseline_values[key]
        modified_val = modified_values.get(key)

        if modified_val is None:
            differences.append({"key": key, "issue": "missing_in_modified", "baseline": baseline_val})
        elif isinstance(baseline_val, float):
            if baseline_val == 0:
                rel_error = abs(modified_val) if modified_val != 0 else 0
            else:
                rel_error = abs(modified_val - baseline_val) / abs(baseline_val)

            if rel_error > tolerance:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "relative_error": rel_error
                })
            else:
                matched += 1
        else:
            if baseline_val != modified_val:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "difference": modified_val - baseline_val
                })
            else:
                matched += 1

    return {
        "correct": len(differences) == 0,
        "matched": matched,
        "total_values": len(baseline_values),
        "differences": differences[:5] if differences else [],
        "total_differences": len(differences)
    }


def main():
    global TARGET_GPU
    import argparse
    parser = argparse.ArgumentParser(description='Run LULESH benchmark')
    parser.add_argument('-s', '--size', type=int, default=DEFAULT_SIZE,
                       help=f'Problem size (elements per side, default: {DEFAULT_SIZE})')
    parser.add_argument('-i', '--iterations', type=int, default=DEFAULT_ITERATIONS,
                       help=f'Number of iterations (default: {DEFAULT_ITERATIONS})')
    parser.add_argument('--gpu', type=str, default=None,
                       help='GPU device to use (default: all available)')
    parser.add_argument('--np', type=int, default=DEFAULT_NP,
                       help=f'Number of MPI ranks — must be a perfect cube (default: {DEFAULT_NP})')
    parser.add_argument('--baseline-only', action='store_true',
                       help='Only run the baseline (pristine) version to establish reference timing. '
                            'Use this before making changes to understand the baseline performance.')
    parser.add_argument('--timing-runs', type=int, default=1,
                       help='Number of timing runs for each version (default: 1). Reports median time.')
    parser.add_argument('--timeout-multiplier', type=float, default=3.0,
                       help='Modified run timeout = baseline_time * multiplier (default: 3.0)')
    args = parser.parse_args()

    TARGET_GPU = args.gpu

    # Validate cube requirement
    if not validate_np_is_cube(args.np):
        sys.exit(1)

    # Find modified LULESH executable
    lulesh_root = os.environ.get('LULESH_ROOT')
    if not lulesh_root:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidate = os.path.join(script_dir, '..', '..', '..', 'Lulesh_test', 'cuda')
        if os.path.isdir(candidate):
            lulesh_root = os.path.abspath(candidate)

    modified_exe = os.path.join(lulesh_root, 'lulesh') if lulesh_root else None

    if not modified_exe or not os.path.isfile(modified_exe):
        print("=" * 60)
        print("ERROR: LULESH executable not found.")
        print("Run lulesh_build first to compile the application.")
        print("=" * 60)
        sys.exit(1)

    # Get pristine executable for baseline
    pristine_exe = get_pristine_executable()
    if not pristine_exe:
        print("=" * 60)
        print("ERROR: Could not build baseline LULESH.")
        print("=" * 60)
        sys.exit(1)

    print("=" * 60)
    print(f"LULESH BENCHMARK: size={args.size}, iterations={args.iterations}, MPI ranks={args.np}")
    cuda_devices = TARGET_GPU if TARGET_GPU is not None else os.environ.get('CUDA_VISIBLE_DEVICES', 'all available')
    print(f"Using GPUs: {cuda_devices}")
    cube_root = round(args.np ** (1.0/3.0))
    print(f"Domain decomposition: {cube_root}x{cube_root}x{cube_root}")
    print("=" * 60)

    num_runs = args.timing_runs

    # --- Warmup run (discarded) ---
    # First CUDA execution on a fresh node is slow (context init, Lustre page cache).
    # Run once to warm up before collecting timing data.
    print("Warmup run (discarded)...")
    sys.stdout.flush()
    warmup_t, _, _ = run_lulesh(pristine_exe, args.size, args.iterations, args.np, "warmup")
    if warmup_t is None:
        print("WARNING: Warmup run failed, proceeding anyway.")
    else:
        print(f"Warmup complete ({warmup_t:.3f}s)")
    sys.stdout.flush()

    # --- Baseline runs ---
    baseline_times = []
    baseline_energy = None
    baseline_output = None

    for i in range(num_runs):
        run_label = f"baseline run {i+1}/{num_runs}" if num_runs > 1 else "baseline (unmodified)"
        t, energy, output = run_lulesh(
            pristine_exe, args.size, args.iterations, args.np, run_label
        )
        if t is None:
            if i == 0:
                print("=" * 60)
                print("ERROR: Baseline run failed.")
                print("=" * 60)
                sys.exit(1)
            print(f"  Baseline run {i+1} failed. Using {len(baseline_times)} successful runs.")
            break
        baseline_times.append(t)
        if i == 0:
            baseline_energy = energy
            baseline_output = output

    baseline_time = statistics.median(baseline_times)

    if args.baseline_only:
        print("=" * 60)
        print("LULESH BASELINE RESULTS")
        print("=" * 60)
        print()
        if num_runs > 1:
            print(f"BASELINE RUNS:   {len(baseline_times)}")
            for i, t in enumerate(baseline_times):
                print(f"  Run {i+1}: {t:.3f}s")
            print(f"BASELINE TIME:   {baseline_time:.3f} seconds (median)")
        else:
            print(f"BASELINE TIME:   {baseline_time:.3f} seconds")
        print(f"Final Energy:    {baseline_energy}")
        print()
        print("This is the reference timing from the unmodified application.")
        print("Make your optimizations, rebuild with lulesh_build, then run lulesh_run")
        print("(without --baseline-only) to compare your modified version against this baseline.")
        print("=" * 60)
        return

    # --- Modified runs ---
    modified_timeout = max(baseline_time * args.timeout_multiplier, 60)
    modified_times = []
    modified_energy = None
    modified_output = None
    timed_out = False

    for i in range(num_runs):
        run_label = f"modified run {i+1}/{num_runs}" if num_runs > 1 else "modified version"
        t, energy, output = run_lulesh(
            modified_exe, args.size, args.iterations, args.np, run_label,
            timeout=modified_timeout
        )
        if t is None:
            if i == 0:
                print("=" * 60)
                print("CORRECTNESS:  FAILED (modified version crashed or failed to run)")
                print()
                print("ERROR: Modified version run failed.")
                print("The binary may have segfaulted, timed out, or produced no output.")
                print("Check your changes and rebuild with lulesh_build.")
                print("=" * 60)
                sys.exit(1)
            print(f"  Modified run {i+1} failed/timed out. Stopping early.")
            timed_out = True
            break
        modified_times.append(t)
        if i == 0:
            modified_energy = energy
            modified_output = output
        # Early stopping: if this run is way slower than baseline
        if t > baseline_time * args.timeout_multiplier:
            if num_runs > 1:
                print(f"  Run {i+1} time ({t:.1f}s) exceeds {args.timeout_multiplier:.0f}x baseline ({baseline_time:.1f}s). Stopping early.")
            timed_out = True
            break

    modified_time = statistics.median(modified_times)

    # Check correctness (first run outputs only)
    correctness = check_correctness(baseline_output, modified_output)

    # Calculate speedup (handle edge cases)
    if modified_time > 0 and baseline_time > 0:
        speedup = baseline_time / modified_time
    elif modified_time > 0:
        speedup = 1.0  # baseline was instant, treat as no change
    else:
        speedup = 1.0  # both instant, treat as no change

    # Print results
    print("=" * 60)
    print("LULESH BENCHMARK RESULTS")
    print("=" * 60)
    print()

    # Correctness
    if correctness.get('correct'):
        print(f"CORRECTNESS:  PASSED ({correctness.get('matched', 0)} values verified)")
        if baseline_energy is not None:
            print(f"  Final Energy: {baseline_energy:.15e} (baseline)")
            print(f"  Final Energy: {modified_energy:.15e} (modified)")
    else:
        print(f"CORRECTNESS:  FAILED ({correctness.get('total_differences', 0)} values differ!)")
        for diff in correctness.get('differences', [])[:3]:
            print(f"  - {diff.get('key')}: expected {diff.get('baseline')}, got {diff.get('modified')}")
    print()

    # Performance
    print(f"BASELINE TIME:   {baseline_time:.3f} seconds")
    print(f"MODIFIED TIME:   {modified_time:.3f} seconds")

    if num_runs > 1:
        print(f"TIMING RUNS:     {len(baseline_times)} baseline, {len(modified_times)} modified")
        print(f"  Baseline per-run: {', '.join(f'{t:.3f}' for t in baseline_times)}")
        print(f"  Modified per-run: {', '.join(f'{t:.3f}' for t in modified_times)}")
        if len(baseline_times) > 1:
            print(f"  Baseline stdev:   {statistics.stdev(baseline_times):.3f}s")
        if len(modified_times) > 1:
            print(f"  Modified stdev:   {statistics.stdev(modified_times):.3f}s")
        if timed_out:
            print(f"  NOTE: Modified runs stopped early (exceeded {args.timeout_multiplier:.0f}x baseline)")
    print()

    if speedup > 1.01:
        print(f"RESULT:          {speedup:.2f}x SPEEDUP")
        print(f"TIME SAVED:      {baseline_time - modified_time:.3f} seconds")
    elif speedup < 0.99:
        slowdown = 1.0 / speedup if speedup > 0 else float('inf')
        print(f"RESULT:          {slowdown:.2f}x SLOWDOWN")
        print(f"TIME ADDED:      {modified_time - baseline_time:.3f} seconds")
    else:
        print("RESULT:          NO SIGNIFICANT CHANGE")

    print()
    print("=" * 60)

    # Determine exit status
    if not correctness.get('correct'):
        print("Status: FAILED (correctness check failed)")
        sys.exit(1)
    elif speedup >= 1.0:
        print("Status: SUCCESS")
        sys.exit(0)
    else:
        print("Status: REGRESSION (slower than baseline)")
        sys.exit(0)


if __name__ == '__main__':
    main()
