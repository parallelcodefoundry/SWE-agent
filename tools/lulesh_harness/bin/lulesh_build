#!/usr/bin/env python3
"""
lulesh_build - Build the LULESH 2.0 CUDA shock hydrodynamics proxy application.

IMPORTANT: The goal is to optimize GPU performance. Do NOT disable
CUDA/GPU support.

Build configuration:
  - Compiler: nvcc (CUDA) for A100 GPUs (sm_80)
  - Base flags: -O3 -std=c++11 -arch=sm_80
  - Features: CUDA GPU support, optional MPI
"""
import subprocess
import os
import sys
import json

# MPI is enabled by default for multi-GPU execution (8 ranks = 2x2x2 cube on 4 GPUs).


def find_lulesh_root():
    """Find the LULESH source directory."""
    lulesh_root = os.environ.get('LULESH_ROOT')
    if lulesh_root and os.path.isdir(lulesh_root):
        return lulesh_root

    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Lulesh_test', 'cuda')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    return None


def find_cuda_path():
    """Find CUDA installation path."""
    cuda_home = os.environ.get('CUDA_HOME') or os.environ.get('CUDATOOLKIT_HOME')
    if cuda_home and os.path.isdir(cuda_home):
        return cuda_home
    candidates = [
        '/opt/nvidia/hpc_sdk/Linux_x86_64/24.5/cuda/12.4',
        '/opt/nvidia/hpc_sdk/Linux_x86_64/23.9/cuda/12.2',
        '/usr/local/cuda',
    ]
    for path in candidates:
        if os.path.isdir(path):
            return path
    return None


EMBEDDED_MAKEFILE = '''# LULESH 2.0 CUDA Makefile for Perlmutter (NVIDIA A100 GPUs)
# Adapted for NERSC Perlmutter with sm_80 architecture

# MPI enabled by default for multi-GPU execution (8 ranks = 2x2x2 on 4 GPUs)
USE_MPI ?= 1

# CUDA settings for Perlmutter A100 (sm_80)
CUDA_HOME ?= $(CUDATOOLKIT_HOME)
NVCC = $(CUDA_HOME)/bin/nvcc
CUDA_ARCH = sm_80

# Host compiler (g++ 13+ is incompatible with nvcc -std=c++11; prefer g++-12)
HOST_CXX ?= $(shell which g++-12 2>/dev/null || which g++-11 2>/dev/null || echo g++)

# Compiler flags
NVCC_FLAGS = -arch=$(CUDA_ARCH) -O3 -std=c++11 -lineinfo
NVCC_FLAGS += --compiler-bindir=$(HOST_CXX)
NVCC_FLAGS += -Xcompiler -fopenmp

# Debug flags (optional)
DEBUG_FLAGS = -g -G -lineinfo

# MPI settings
ifeq ($(USE_MPI),1)
    MPI_FLAGS = -DUSE_MPI
    MPI_INCLUDES = -I$(MPICH_DIR)/include
    MPI_LIBS = -L$(MPICH_DIR)/lib -lmpi
else
    MPI_FLAGS =
    MPI_INCLUDES =
    MPI_LIBS =
endif

# Include paths
INCLUDES = -I./src $(MPI_INCLUDES)

# Libraries
LIBS = -L$(CUDA_HOME)/lib64 -lcudart -lgomp $(MPI_LIBS)

# Source files
SRC_DIR = src
SRCS = $(SRC_DIR)/allocator.cu $(SRC_DIR)/lulesh.cu
ifeq ($(USE_MPI),1)
    SRCS += $(SRC_DIR)/lulesh-comms.cu $(SRC_DIR)/lulesh-comms-gpu.cu
endif

# Object files
OBJS = $(SRCS:.cu=.o)

# Target executable
TARGET = lulesh

# Default target
all: release

release: NVCC_FLAGS += -DNDEBUG
release: $(TARGET)

debug: NVCC_FLAGS += $(DEBUG_FLAGS)
debug: $(TARGET)

$(TARGET): $(OBJS)
	$(NVCC) $(NVCC_FLAGS) $(MPI_FLAGS) -o $@ $^ $(LIBS)

$(SRC_DIR)/%.o: $(SRC_DIR)/%.cu
	$(NVCC) $(NVCC_FLAGS) $(MPI_FLAGS) $(INCLUDES) -c $< -o $@

clean:
	rm -f $(SRC_DIR)/*.o $(TARGET)

# Run with default parameters (small test)
test: $(TARGET)
	./$(TARGET) -s 20 -i 100

# Run with larger problem
benchmark: $(TARGET)
	./$(TARGET) -s 30 -i 200

.PHONY: all release debug clean test benchmark
'''


def ensure_makefile_exists(lulesh_root):
    """Ensure Makefile exists in the test directory, generating if needed."""
    makefile_path = os.path.join(lulesh_root, 'Makefile')

    if os.path.isfile(makefile_path):
        return True  # Makefile already exists

    # Generate Makefile from embedded template
    print(f"Generating Makefile in {lulesh_root}...")
    try:
        with open(makefile_path, 'w') as f:
            f.write(EMBEDDED_MAKEFILE)
        print("Makefile generated successfully")
        return True
    except Exception as e:
        print(f"Warning: Failed to generate Makefile: {e}")
        return False


def main():
    import argparse
    parser = argparse.ArgumentParser(description='Build LULESH')
    parser.add_argument('--clean', action='store_true',
                       help='Force clean rebuild (make clean first)')
    parser.add_argument('--use-mpi', action='store_true', default=True,
                       help='Enable MPI support for multi-GPU runs (default: enabled)')
    parser.add_argument('--no-mpi', action='store_true',
                       help='Disable MPI support (single GPU only)')
    args = parser.parse_args()

    # --no-mpi overrides the default MPI-enabled behavior
    if args.no_mpi:
        args.use_mpi = False

    lulesh_root = find_lulesh_root()
    if not lulesh_root:
        print(json.dumps({
            "success": False,
            "error": "Could not find LULESH source directory"
        }))
        sys.exit(1)

    # Ensure Makefile exists (copy from pristine if needed)
    if not ensure_makefile_exists(lulesh_root):
        print(json.dumps({
            "success": False,
            "error": f"Makefile not found in {lulesh_root} and could not copy from pristine directory"
        }))
        sys.exit(1)

    cuda_path = find_cuda_path()
    build_env = os.environ.copy()
    if cuda_path:
        build_env['CUDATOOLKIT_HOME'] = cuda_path

    print(f"Building LULESH in: {lulesh_root}")
    print(f"CUDA path: {cuda_path}")

    # Clean if requested
    if args.clean:
        print("Cleaning previous build...")
        subprocess.run(['make', 'clean'], cwd=lulesh_root, env=build_env,
                      capture_output=True)

    # Build
    make_args = ['make', '-j8']
    if args.use_mpi:
        make_args.append('USE_MPI=1')

    print(f"Running: {' '.join(make_args)}")
    sys.stdout.flush()

    result = subprocess.run(
        make_args,
        cwd=lulesh_root,
        capture_output=True,
        text=True,
        timeout=600,
        env=build_env
    )

    exe_path = os.path.join(lulesh_root, 'lulesh')

    if result.returncode == 0 and os.path.isfile(exe_path):
        print(json.dumps({
            "success": True,
            "executable": exe_path,
            "message": "Build successful"
        }))
        print("\nBuild successful!")
        print(f"Executable: {exe_path}")
        sys.exit(0)
    else:
        print(json.dumps({
            "success": False,
            "error": result.stderr[-1000:] if result.stderr else "Unknown error"
        }))
        print("\nBuild FAILED!")
        if result.stderr:
            print(result.stderr[-1000:])
        sys.exit(1)


if __name__ == '__main__':
    main()
