#!/usr/bin/env python3
"""
kripke_run - Run Kripke with specified parameters using MPI.
Compares timing against baseline and reports speedup.
Also verifies correctness by comparing scientific values between runs.
"""
import argparse
import subprocess
import os
import sys
import json
import time
import re
import statistics

# Pristine Kripke source (unmodified)
def _find_pristine_kripke():
    root = os.environ.get('PRISTINE_KRIPKE_ROOT')
    if root and os.path.isdir(root):
        return root
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, '..', '..', '..', 'Kripke')
    if os.path.isdir(candidate):
        return os.path.abspath(candidate)
    swe_root = os.environ.get('SWE_AGENT_ROOT')
    if swe_root:
        candidate = os.path.join(swe_root, 'Kripke')
        if os.path.isdir(candidate):
            return os.path.abspath(candidate)
    print("ERROR: Pristine Kripke not found. Set PRISTINE_KRIPKE_ROOT or run setup_apps.sh.", file=sys.stderr)
    return None

PRISTINE_KRIPKE_ROOT = _find_pristine_kripke()

# Default tolerance for correctness checking (relative error)
# Kripke is deterministic, so we use a tight tolerance.
# Allow small floating-point variance from reordering/fast-math.
DEFAULT_TOLERANCE = 1e-6

def get_pristine_executable(arch='OpenMP'):
    """Get path to pristine Kripke executable, building if needed.

    Uses architecture-specific build directories to support both OpenMP and CUDA
    baselines without rebuilding each time.
    """
    # Check the default build/ directory first (where setup_apps.sh puts it)
    default_exe = os.path.join(PRISTINE_KRIPKE_ROOT, 'build', 'kripke.exe')
    if os.path.isfile(default_exe):
        print(f"Using pre-built pristine Kripke: {default_exe}", file=sys.stderr)
        return default_exe

    # Fall back to architecture-specific build directories
    build_dir_name = f'build_{arch.lower()}'
    build_dir = os.path.join(PRISTINE_KRIPKE_ROOT, build_dir_name)
    exe_path = os.path.join(build_dir, 'kripke.exe')

    if not os.path.isfile(exe_path):
        # Need to build pristine version for this architecture
        print("=" * 60, file=sys.stderr)
        print(f"Building pristine Kripke ({arch}) for baseline...", file=sys.stderr)
        print("=" * 60, file=sys.stderr)

        os.makedirs(build_dir, exist_ok=True)

        # Configure with cmake based on architecture
        if not os.path.exists(os.path.join(build_dir, 'Makefile')) and \
           not os.path.exists(os.path.join(build_dir, 'build.ninja')):

            # Build cmake command based on architecture
            cmake_cmd = ['cmake', '..']

            if arch.upper() == 'CUDA':
                cmake_cmd.extend([
                    '-DENABLE_CUDA=ON',
                    '-DCMAKE_CUDA_ARCHITECTURES=80',  # A100 GPUs
                    '-DENABLE_OPENMP=ON',
                    '-DCMAKE_BUILD_TYPE=Release'
                ])
            elif arch.upper() == 'HIP':
                cmake_cmd.extend([
                    '-DENABLE_HIP=ON',
                    '-DENABLE_OPENMP=ON',
                    '-DCMAKE_BUILD_TYPE=Release'
                ])
            else:  # OpenMP or Sequential
                cmake_cmd.extend([
                    '-DENABLE_OPENMP=ON',
                    '-DCMAKE_BUILD_TYPE=Release'
                ])

            print(f"  CMake: {' '.join(cmake_cmd)}", file=sys.stderr)
            cmake_result = subprocess.run(
                cmake_cmd,
                cwd=build_dir,
                capture_output=True,
                text=True,
                timeout=300  # CUDA config can take longer
            )
            if cmake_result.returncode != 0:
                print(f"CMake failed: {cmake_result.stderr}", file=sys.stderr)
                return None

        build_result = subprocess.run(
            ['make', '-j8'],
            cwd=build_dir,
            capture_output=True,
            text=True,
            timeout=600  # CUDA builds take longer
        )

        if build_result.returncode != 0 or not os.path.isfile(exe_path):
            print(f"Failed to build pristine Kripke: {build_result.stderr}", file=sys.stderr)
            return None

        print(f"Pristine {arch} build complete.", file=sys.stderr)

    return exe_path

def run_baseline(args, env, timeout=600):
    """Run pristine Kripke to establish baseline timing.

    IMPORTANT: Always runs with IDENTICAL parameters as the modified version
    to ensure fair comparison. No caching - baseline is calculated fresh each time.
    Builds pristine with the SAME architecture to ensure apples-to-apples comparison.

    Returns: (timing_dict, stdout_str) or (None, None) on failure
    """
    exe_path = get_pristine_executable(args.arch)
    if not exe_path:
        return None, None

    print("=" * 60, file=sys.stderr)
    print(f"BASELINE RUN: Unmodified Kripke ({args.arch}) with IDENTICAL parameters", file=sys.stderr)
    print(f"  Arch: {args.arch}, Layout: {args.layout}, Zones: {args.zones}", file=sys.stderr)
    print(f"  Groups: {args.groups}, Iterations: {args.niter}, Quad: {args.quad}", file=sys.stderr)
    print(f"  MPI ranks: {args.np}, OMP threads: {args.omp_threads}", file=sys.stderr)
    print("=" * 60, file=sys.stderr)

    # Build command with same parameters
    kripke_cmd = [
        exe_path,
        '--arch', args.arch,
        '--layout', args.layout,
        '--zones', args.zones,
        '--groups', str(args.groups),
        '--niter', str(args.niter),
        '--quad', str(args.quad),
        '--procs', args.procs
    ]

    # Always use mpirun for MPI execution (avoids nested srun hangs in batch mode).
    # Bind each rank to a specific GPU via OMPI_COMM_WORLD_LOCAL_RANK to prevent
    # CUDA illegal memory access from all ranks competing for the same GPU.
    if args.np > 1:
        # Wrapper sets CUDA_VISIBLE_DEVICES per rank so each rank gets one GPU
        cmd = ['mpirun', '-np', str(args.np), '--bind-to', 'none', '--oversubscribe',
               'bash', '-c', 'export CUDA_VISIBLE_DEVICES=$OMPI_COMM_WORLD_LOCAL_RANK; exec "$@"',
               '--'] + kripke_cmd
    else:
        cmd = kripke_cmd

    try:
        proc = subprocess.run(
            cmd,
            cwd=os.path.dirname(exe_path),
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env
        )

        if proc.returncode == 0:
            timing = parse_timing_from_output(proc.stdout)
            if timing and 'Solve' in timing:
                print(f"Baseline completed: {timing['Solve']:.3f}s solve time", file=sys.stderr)
                print("=" * 60, file=sys.stderr)
                return timing, proc.stdout
            else:
                print("Failed to parse baseline timing from output", file=sys.stderr)
        else:
            print(f"Baseline run failed: {proc.stderr[-500:]}", file=sys.stderr)
    except Exception as e:
        print(f"Baseline run error: {e}", file=sys.stderr)

    return None, None

def get_baseline(args, env):
    """Get baseline timing and output by running pristine Kripke with IDENTICAL parameters.

    No caching - always runs fresh to ensure fair comparison with the exact same
    configuration (zones, groups, MPI ranks, OMP threads, etc.).

    Returns: (timing_dict, stdout_str) or (None, None) on failure
    """
    return run_baseline(args, env)


def extract_scientific_values(output_text):
    """Extract SCIENTIFIC values from Kripke output for correctness comparison.

    Parses both configuration parameters (integer-exact) and physics values
    (floating point with tolerance). Kripke outputs:
    - Configuration: niter, zones, groups, directions, unknowns
    - Physics: particle flux (Unknowns per direction), total unknowns, throughput

    NOTE: Timing/throughput metrics are excluded because those naturally vary
    between runs and are NOT correctness indicators.
    """
    values = {}

    # --- Configuration parameters (must match exactly) ---

    # Iteration count
    iter_match = re.search(r'niter\s*[=:]\s*(\d+)', output_text, re.IGNORECASE)
    if iter_match:
        values['iterations'] = int(iter_match.group(1))

    # Zone counts
    zones_match = re.search(r'zones\s*[=:]\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)', output_text)
    if zones_match:
        values['zones_x'] = int(zones_match.group(1))
        values['zones_y'] = int(zones_match.group(2))
        values['zones_z'] = int(zones_match.group(3))

    # Groups
    groups_match = re.search(r'groups\s*[=:]\s*(\d+)', output_text, re.IGNORECASE)
    if groups_match:
        values['groups'] = int(groups_match.group(1))

    # --- Physics / problem size values (correctness indicators) ---

    # Total number of unknowns (depends on zones, groups, directions, decomposition)
    unknowns_match = re.search(r'Total\s+(?:Number\s+of\s+)?Unknowns\s*[=:]\s*([\d.eE+\-]+)', output_text, re.IGNORECASE)
    if unknowns_match:
        values['total_unknowns'] = float(unknowns_match.group(1))

    # Unknowns per direction (key physics parameter)
    upd_match = re.search(r'Unknowns\s+per\s+direction\s*[=:]\s*([\d.eE+\-]+)', output_text, re.IGNORECASE)
    if upd_match:
        values['unknowns_per_direction'] = float(upd_match.group(1))

    # Number of directions (quadrature-dependent)
    dirs_match = re.search(r'(?:Total\s+)?(?:Number\s+of\s+)?[Dd]irections\s*[=:]\s*(\d+)', output_text)
    if dirs_match:
        values['directions'] = int(dirs_match.group(1))

    # Look for any "phi" or flux values in the output (some Kripke versions print them)
    phi_match = re.search(r'phi\s*[=:]\s*([\d.eE+\-]+)', output_text, re.IGNORECASE)
    if phi_match:
        values['phi'] = float(phi_match.group(1))

    # Timer counts (verify same number of kernel invocations)
    # e.g., "  Solve                 1      28.22815" — count column confirms algorithm ran
    # Source: Timing.cpp printf("  %-16s  %12d  %12.5lf\n", name, count, seconds)
    for line in output_text.split('\n'):
        solve_match = re.match(r'\s*Solve\s+(\d+)\s+([\d.eE+-]+)\s*$', line)
        if solve_match:
            values['solve_count'] = int(solve_match.group(1))
            break

    return values


def check_correctness(baseline_output, modified_output, tolerance=DEFAULT_TOLERANCE):
    """Compare scientific values between baseline and modified outputs.

    Returns: dict with 'correct' (bool), 'matched' (int), 'differences' (list)
    """
    baseline_values = extract_scientific_values(baseline_output)
    modified_values = extract_scientific_values(modified_output)

    # For Kripke, if both runs complete successfully with same params,
    # consider it correct (deterministic transport solver)
    if not baseline_values and not modified_values:
        return {"correct": True, "matched": 0, "note": "No specific values to compare, both runs completed"}

    differences = []
    matched = 0

    for key in baseline_values.keys():
        baseline_val = baseline_values[key]
        modified_val = modified_values.get(key)

        if modified_val is None:
            differences.append({"key": key, "issue": "missing_in_modified", "baseline": baseline_val})
        elif isinstance(baseline_val, float):
            if baseline_val == 0:
                rel_error = abs(modified_val) if modified_val != 0 else 0
            else:
                rel_error = abs(modified_val - baseline_val) / abs(baseline_val)

            if rel_error > tolerance:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "relative_error": rel_error
                })
            else:
                matched += 1
        else:
            if baseline_val != modified_val:
                differences.append({
                    "key": key,
                    "baseline": baseline_val,
                    "modified": modified_val,
                    "difference": modified_val - baseline_val
                })
            else:
                matched += 1

    return {
        "correct": len(differences) == 0,
        "matched": matched,
        "total_values": len(baseline_values),
        "differences": differences[:5] if differences else [],
        "total_differences": len(differences)
    }

def parse_timing_from_output(stdout):
    """Extract timing information from Kripke output."""
    timing = {}

    # Parse timer output lines like:
    # "  Timer              Count        Seconds"
    # "  Solve                 1      28.22815"
    # Source: Timing.cpp printf("  %-16s  %12d  %12.5lf\n", name, count, seconds)
    for line in stdout.split('\n'):
        # Format: name  count(int)  seconds(float)
        match = re.match(r'\s*(\w+)\s+(\d+)\s+([\d.eE+-]+)\s*$', line)
        if match:
            name = match.group(1)
            total_s = float(match.group(3))
            timing[name] = total_s

    return timing

def calculate_speedup(baseline, current):
    """Calculate speedup metrics comparing current to baseline."""
    speedup = {}

    if baseline and current:
        # Primary speedup: Solve time (main computational phase)
        if 'Solve' in baseline and 'Solve' in current:
            if current['Solve'] > 0:
                speedup['solve_speedup'] = baseline['Solve'] / current['Solve']
                speedup['solve_baseline_s'] = baseline['Solve']
                speedup['solve_current_s'] = current['Solve']
                speedup['solve_time_saved_s'] = baseline['Solve'] - current['Solve']

        # SweepSolver speedup
        if 'SweepSolver' in baseline and 'SweepSolver' in current:
            if current['SweepSolver'] > 0:
                speedup['sweepsolver_speedup'] = baseline['SweepSolver'] / current['SweepSolver']
                speedup['sweepsolver_baseline_s'] = baseline['SweepSolver']
                speedup['sweepsolver_current_s'] = current['SweepSolver']

        # LTimes speedup
        if 'LTimes' in baseline and 'LTimes' in current:
            if current['LTimes'] > 0:
                speedup['ltimes_speedup'] = baseline['LTimes'] / current['LTimes']
                speedup['ltimes_baseline_s'] = baseline['LTimes']
                speedup['ltimes_current_s'] = current['LTimes']

        # LPlusTimes speedup
        if 'LPlusTimes' in baseline and 'LPlusTimes' in current:
            if current['LPlusTimes'] > 0:
                speedup['lplustimes_speedup'] = baseline['LPlusTimes'] / current['LPlusTimes']
                speedup['lplustimes_baseline_s'] = baseline['LPlusTimes']
                speedup['lplustimes_current_s'] = current['LPlusTimes']

    return speedup

def format_speedup_summary(speedup, correctness, args):
    """Format speedup and correctness summary for prominent display."""
    lines = []
    lines.append("=" * 60)
    lines.append("PERFORMANCE & CORRECTNESS COMPARISON: Modified vs Pristine")
    lines.append("(Both runs used IDENTICAL configuration for fair comparison)")
    lines.append(f"  MPI ranks: {args.np}, OMP threads: {args.omp_threads}")
    lines.append("=" * 60)

    # Correctness section
    if correctness:
        if correctness.get('correct'):
            lines.append(f"CORRECTNESS:     PASSED ({correctness.get('matched', 0)} values match)")
        else:
            lines.append(f"CORRECTNESS:     FAILED ({correctness.get('total_differences', 0)} values differ!)")
            for diff in correctness.get('differences', [])[:3]:
                lines.append(f"  - {diff.get('key')}: expected {diff.get('baseline')}, got {diff.get('modified')}")
    lines.append("-" * 60)

    if 'solve_speedup' in speedup:
        sp = speedup['solve_speedup']
        if sp > 1.0:
            status = f"FASTER (speedup: {sp:.2f}x)"
        elif sp < 1.0:
            status = f"SLOWER (slowdown: {1/sp:.2f}x)"
        else:
            status = "NO CHANGE"

        lines.append(f"Solve Time:      {speedup.get('solve_current_s', 'N/A'):.3f}s vs baseline {speedup.get('solve_baseline_s', 'N/A'):.3f}s")
        lines.append(f"Result:          {status}")
        if 'solve_time_saved_s' in speedup:
            saved = speedup['solve_time_saved_s']
            if saved > 0:
                lines.append(f"Time Saved:      {saved:.3f}s")
            else:
                lines.append(f"Time Added:      {-saved:.3f}s")
    else:
        lines.append("Could not calculate speedup (timing data missing)")

    if 'sweepsolver_speedup' in speedup:
        sp = speedup['sweepsolver_speedup']
        lines.append(f"SweepSolver:     {speedup.get('sweepsolver_current_s', 'N/A'):.3f}s vs baseline {speedup.get('sweepsolver_baseline_s', 'N/A'):.3f}s (speedup: {sp:.2f}x)")

    if 'ltimes_speedup' in speedup:
        sp = speedup['ltimes_speedup']
        lines.append(f"LTimes:          {speedup.get('ltimes_current_s', 'N/A'):.3f}s vs baseline {speedup.get('ltimes_baseline_s', 'N/A'):.3f}s (speedup: {sp:.2f}x)")

    if 'lplustimes_speedup' in speedup:
        sp = speedup['lplustimes_speedup']
        lines.append(f"LPlusTimes:      {speedup.get('lplustimes_current_s', 'N/A'):.3f}s vs baseline {speedup.get('lplustimes_baseline_s', 'N/A'):.3f}s (speedup: {sp:.2f}x)")

    lines.append("=" * 60)
    return "\n".join(lines)

def main():
    parser = argparse.ArgumentParser(description='Run Kripke')
    parser.add_argument('--arch', default='OpenMP', help='Backend: Sequential, OpenMP, CUDA, HIP')
    parser.add_argument('--layout', default='DGZ', help='Data layout: DGZ, DZG, GDZ, GZD, ZDG, ZGD')
    parser.add_argument('--zones', default='32,32,32', help='Zone dimensions as x,y,z')
    parser.add_argument('--groups', type=int, default=64, help='Number of energy groups')
    parser.add_argument('--niter', type=int, default=10, help='Number of iterations')
    parser.add_argument('--quad', type=int, default=8, help='Quadrature order')
    parser.add_argument('--np', type=int, default=1, help='Number of MPI ranks')
    parser.add_argument('--procs', type=str, help='MPI decomposition as px,py,pz (must equal np)')
    parser.add_argument('--omp-threads', type=int, default=8, help='OpenMP threads per rank')
    parser.add_argument('--output', type=str, help='Output file path')
    parser.add_argument('--baseline-only', action='store_true',
                       help='Only run the baseline (pristine) version to establish reference timing. '
                            'Use this before making changes to understand the baseline performance.')
    parser.add_argument('--timing-runs', type=int, default=1,
                       help='Number of timing runs for each version (default: 1). Reports median time.')
    parser.add_argument('--timeout-multiplier', type=float, default=3.0,
                       help='Modified run timeout = baseline_time * multiplier (default: 3.0)')
    args = parser.parse_args()

    # Compute default procs decomposition if not specified
    if not args.procs:
        # Find a factorization for the number of ranks
        np = args.np
        if np == 1:
            args.procs = '1,1,1'
        elif np == 2:
            args.procs = '2,1,1'
        elif np == 4:
            args.procs = '2,2,1'
        elif np == 8:
            args.procs = '2,2,2'
        else:
            # Default: linear decomposition in x
            args.procs = f'{np},1,1'

    # Find Kripke executable
    kripke_root = os.environ.get('KRIPKE_ROOT')
    if not kripke_root:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidate = os.path.join(script_dir, '..', '..', '..', 'Kripke')
        if os.path.isdir(candidate):
            kripke_root = os.path.abspath(candidate)

    exe_path = os.path.join(kripke_root, 'build', 'kripke.exe') if kripke_root else None

    if not exe_path or not os.path.isfile(exe_path):
        print(json.dumps({
            "success": False,
            "error": "Kripke executable not found. Run kripke_build first."
        }))
        sys.exit(1)

    result = {
        "success": False,
        "executable": exe_path,
        "parameters": {
            "arch": args.arch,
            "layout": args.layout,
            "zones": args.zones,
            "groups": args.groups,
            "niter": args.niter,
            "quad": args.quad,
            "procs": args.procs
        },
        "mpi_ranks": args.np,
        "omp_threads": args.omp_threads
    }

    # Set OpenMP environment
    env = os.environ.copy()
    env['OMP_NUM_THREADS'] = str(args.omp_threads)
    env['OMP_PROC_BIND'] = 'spread'
    env['OMP_PLACES'] = 'threads'

    num_runs = args.timing_runs

    # --- Warmup run (discarded) ---
    # First CUDA execution on a fresh node is slow (context init, Lustre page cache).
    # Run once to warm up before collecting timing data.
    print("Warmup run (discarded)...", file=sys.stderr)
    warmup_timing, _ = run_baseline(args, env)
    if warmup_timing is None or 'Solve' not in warmup_timing:
        print("WARNING: Warmup run failed, proceeding anyway.", file=sys.stderr)
    else:
        print(f"Warmup complete ({warmup_timing['Solve']:.3f}s)", file=sys.stderr)

    # --- Baseline runs ---
    baseline_solve_times = []
    baseline_timing = None
    baseline_output = None

    for i in range(num_runs):
        if num_runs > 1:
            print(f"Baseline run {i+1}/{num_runs}...", file=sys.stderr)
        b_timing, b_output = run_baseline(args, env)
        if b_timing is None or 'Solve' not in b_timing:
            if i == 0:
                break  # First baseline failed
            print(f"  Baseline run {i+1} failed. Using {len(baseline_solve_times)} successful runs.", file=sys.stderr)
            break
        baseline_solve_times.append(b_timing['Solve'])
        if i == 0:
            baseline_timing = b_timing
            baseline_output = b_output

    if args.baseline_only:
        if baseline_solve_times:
            baseline_result = {
                "success": True,
                "baseline_only": True,
                "baseline_timing": baseline_timing,
                "message": "Baseline timing established. Make optimizations, rebuild with kripke_build, "
                           "then run kripke_run (without --baseline-only) to compare.",
            }
            if num_runs > 1:
                baseline_result["baseline_solve_times"] = baseline_solve_times
                baseline_result["baseline_solve_median"] = statistics.median(baseline_solve_times)
        else:
            baseline_result = {
                "success": False,
                "baseline_only": True,
                "error": "Baseline run failed",
            }
        print(json.dumps(baseline_result, indent=2))
        sys.exit(0 if baseline_result["success"] else 1)

    # Build Kripke command for modified version
    kripke_cmd = [
        exe_path,
        '--arch', args.arch,
        '--layout', args.layout,
        '--zones', args.zones,
        '--groups', str(args.groups),
        '--niter', str(args.niter),
        '--quad', str(args.quad),
        '--procs', args.procs
    ]

    # Always use mpirun for MPI execution (avoids nested srun hangs in batch mode).
    if args.np > 1:
        cmd = ['mpirun', '-np', str(args.np), '--bind-to', 'none', '--oversubscribe',
               'bash', '-c', 'export CUDA_VISIBLE_DEVICES=$OMPI_COMM_WORLD_LOCAL_RANK; exec "$@"',
               '--'] + kripke_cmd
    else:
        cmd = kripke_cmd

    # --- Modified runs ---
    baseline_solve_median = statistics.median(baseline_solve_times) if baseline_solve_times else 600
    modified_timeout = max(baseline_solve_median * args.timeout_multiplier, 60)

    modified_solve_times = []
    modified_timing = None
    modified_output = None
    correctness = None
    timed_out = False

    for i in range(num_runs):
        run_label = f"modified run {i+1}/{num_runs}" if num_runs > 1 else "modified"
        print(f"Running {run_label}...", file=sys.stderr)
        print(f"  Command: {' '.join(cmd)}", file=sys.stderr)

        try:
            start_time = time.time()
            proc = subprocess.run(
                cmd,
                cwd=os.path.dirname(exe_path),
                capture_output=True,
                text=True,
                timeout=modified_timeout,
                env=env
            )
            elapsed = time.time() - start_time

            if proc.returncode == 0:
                m_timing = parse_timing_from_output(proc.stdout)
                if m_timing and 'Solve' in m_timing:
                    modified_solve_times.append(m_timing['Solve'])
                    if i == 0:
                        modified_timing = m_timing
                        modified_output = proc.stdout
                        result["returncode"] = proc.returncode
                        result["elapsed_seconds"] = elapsed
                        result["stdout"] = proc.stdout
                        result["stderr"] = proc.stderr[-2000:] if len(proc.stderr) > 2000 else proc.stderr
                        # Correctness check on first run only
                        if baseline_output:
                            correctness = check_correctness(baseline_output, proc.stdout)
                            result["correctness"] = correctness
                    # Early stopping
                    if m_timing['Solve'] > baseline_solve_median * args.timeout_multiplier:
                        if num_runs > 1:
                            print(f"  Solve time ({m_timing['Solve']:.3f}s) exceeds {args.timeout_multiplier:.0f}x baseline ({baseline_solve_median:.3f}s). Stopping.", file=sys.stderr)
                        timed_out = True
                        break
                else:
                    if i == 0:
                        result["error"] = "Failed to parse timing from modified run output"
                        break
                    timed_out = True
                    break
            else:
                if i == 0:
                    result["returncode"] = proc.returncode
                    result["stderr"] = proc.stderr[-2000:] if len(proc.stderr) > 2000 else proc.stderr
                    result["error"] = f"Modified run failed (exit {proc.returncode})"
                    break
                print(f"  Modified run {i+1} failed. Stopping early.", file=sys.stderr)
                timed_out = True
                break

        except subprocess.TimeoutExpired:
            if i == 0:
                result["error"] = f"Modified run timed out (>{modified_timeout:.0f}s)"
                break
            print(f"  Modified run {i+1} timed out. Stopping early.", file=sys.stderr)
            timed_out = True
            break
        except Exception as e:
            if i == 0:
                result["error"] = str(e)
                break
            timed_out = True
            break

    # Calculate speedup using medians
    if modified_solve_times and baseline_solve_times:
        result["success"] = True
        modified_solve_median = statistics.median(modified_solve_times)

        # Build timing dicts with median values for speedup calculation
        baseline_for_speedup = dict(baseline_timing)
        baseline_for_speedup['Solve'] = baseline_solve_median
        modified_for_speedup = dict(modified_timing)
        modified_for_speedup['Solve'] = modified_solve_median

        speedup = calculate_speedup(baseline_for_speedup, modified_for_speedup)
        result["speedup"] = speedup
        result["baseline_timing"] = baseline_timing
        result["timing"] = modified_timing

        # Multi-run stats
        if num_runs > 1:
            result["multi_run"] = {
                "num_baseline_runs": len(baseline_solve_times),
                "num_modified_runs": len(modified_solve_times),
                "baseline_solve_times": baseline_solve_times,
                "modified_solve_times": modified_solve_times,
                "baseline_solve_median": baseline_solve_median,
                "modified_solve_median": modified_solve_median,
                "early_stopped": timed_out,
            }
            if len(baseline_solve_times) > 1:
                result["multi_run"]["baseline_solve_stdev"] = statistics.stdev(baseline_solve_times)
            if len(modified_solve_times) > 1:
                result["multi_run"]["modified_solve_stdev"] = statistics.stdev(modified_solve_times)

        # Print prominent speedup and correctness summary
        print("\n" + format_speedup_summary(speedup, correctness, args), file=sys.stderr)

    # Save output to file if requested
    if args.output and modified_output:
        with open(args.output, 'w') as f:
            f.write(modified_output)
        result["output_file"] = args.output

    # Print CORRECTNESS summary to stderr so benchmark runner can parse it.
    # On success, format_speedup_summary already printed CORRECTNESS to stderr.
    # On failure, we need to explicitly output CORRECTNESS: FAILED.
    if not result["success"]:
        error_msg = result.get("error", "unknown error")
        print(f"\nCORRECTNESS:     FAILED (run failed: {error_msg})", file=sys.stderr)

    print(json.dumps(result, indent=2))
    sys.exit(0 if result["success"] else 1)

if __name__ == '__main__':
    main()
